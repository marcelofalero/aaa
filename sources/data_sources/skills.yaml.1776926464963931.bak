              <td>-1</td>
              
              <td>Good</td>
              
              </tr>
              
              <tr>
              
              <td>Wild</td>
              
              <td>+1</td>
              
              <td>Amazing</td>
              
              </tr>
              
              <tr class="table-category">
              
              <td colspan="3"><strong>Carnivores</strong></td>
              
              </tr>
              
              <tr>
              
              <td>Alien</td>
              
              <td>+5</td>
              
              <td>Amazing</td>
              
              </tr>
              
              <tr>
              
              <td>Domestic</td>
              
              <td>-2</td>
              
              <td>Ordinary</td>
              
              </tr>
              
              <tr>
              
              <td>Wild</td>
              
              <td>+4</td>
              
              <td>Good</td>
              
              </tr>
              
              </tbody>
              
              </table>
              
              </div>
              
              
              ### Other Modifiers
              
              
              <div class="table-wrapper">
              
              <table>
              
              <thead>
              
              <tr>
              
              <th>Circumstance</th>
              
              <th>Modifier</th>
              
              </tr>
              
              </thead>
              
              <tbody>
              
              <tr>
              
              <td><strong>Unfamiliar animal</strong></td>
              
              <td>+2</td>
              
              </tr>
              
              <tr>
              
