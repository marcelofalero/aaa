              </tr>
              
              <tr>
              
              <td>    Ordinary task</td>
              
              <td>-1</td>
              
              </tr>
              
              <tr>
              
              <td>    Good task</td>
              
              <td>+1</td>
              
              </tr>
              
              <tr>
              
              <td>    Amazing task</td>
              
              <td>+3</td>
              
              </tr>
              
              <tr class="table-category">
              
              <td colspan="2"><strong>Untrained animal</strong></td>
              
              </tr>
              
              <tr>
              
              <td>    Ordinary task</td>
              
              <td>+1</td>
              
              </tr>
              
              <tr class="table-category">
              
              <td colspan="2"><strong>Wild animal</strong></td>
              
              </tr>
              
              <tr class="table-row-last">
              
