search_config:
  display_name: WEAPONS
  base_url: /equipment/weapons/
  section: equipment
melee:
  config:
    default:
      columns:
        en:
        - name: Weapon
          key: name
        - name: Skill
          key: skill
        - name: Acc
          key: acc
        - name: Type
          key: type
        - name: Damage (O/G/A)
          key: damage
        - name: Actions
          key: actions
        - name: Mass
          key: mass
        - name: Hide
          key: hide
        - name: Avail
          key: avail
        - name: Cost ($)
          key: cost
        - name: Description
          key: description
          hidden: true
        es:
        - name: Arma
          key: name
        - name: Habilidad
          key: skill
        - name: Acc
          key: acc
        - name: Daño (O/G/A)
          key: damage
        - name: Comportamiento
          key: actions
        - name: Masa
          key: mass
        - name: Aprovechar
          key: avail
        - name: Costo ($)
          key: cost
        - name: Descripción
          key: description
          hidden: true
        - name: Costo del clip
          key: clip_cost
          hidden: true
        - name: Esconder
          key: hide_modifier
          hidden: true
  items:
    pl-0-stone-age:
      localized:
      - en:
          name: 'PL 0: Stone Age'
      - es:
          name: 'PL 0: Edad de Piedra'
      items:
        club:
          skill: Melee-bludgeon
          acc: '0'
          type: LI/O
          damage: d4+1s/d4w/d4+1w
          actions: '3'
          mass: '2'
          hide: '+12'
          avail: Any
          cost: '10'
          localized:
          - en:
              name: Club
              description: A heavy stick or cudgel, simple but effective.
          - es:
              name: Club
              description: Un palo o garrote pesado, sencillo pero eficaz.
        dagger:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4w/d4w+1/d4+2w
          actions: '4'
          mass: '1'
          hide: '+3'
          avail: Any
          cost: '20'
          localized:
          - en:
              name: Dagger
              description: A short, double-edged blade used for stabbing or thrusting.
          - es:
              name: Daga
              description: |-
                Una hoja corta de doble filo que se utiliza para apuñalar o empujar.
        quarterstaff:
          skill: Melee-bludgeon
          acc: '-1'
          type: LI/O
          damage: d4+1s/d4+3s/d6w
          actions: '3'
          mass: '2'
          hide: '-'
          avail: Any
          cost: '15'
          localized:
          - en:
              name: Quarterstaff
              description: A long, sturdy pole of wood, often shod with iron.
          - es:
              name: Barra
              description: |-
                Un poste de madera largo y resistente, a menudo forrado con hierro.
        spear:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4w/d4+2w/d4m
          actions: '3'
          mass: '2'
          hide: '-'
          avail: Any
          cost: '15'
          localized:
          - en:
              name: Spear
              description: A pole weapon with a sharp point, designed for thrusting.
          - es:
              name: Lanza
              description: |-
                Un arma de asta con una punta afilada, diseñada para empujar.
        unarmed:
          skill: Unarmed Attack
          acc: '0'
          type: LI/O
          damage: d4s/d4+1s/d4+2s
          actions: '4'
          mass: '-'
          hide: '-'
          avail: Any
          cost: '35'
          localized:
          - en:
              name: Unarmed
              description: Fighting with bare hands, feet, or other natural weapons.
          - es:
              name: Desarmado
              description: |-
                Pelear con las manos, los pies u otras armas naturales desnudos.
    pl-1-bronze-iron-age:
      localized:
      - en:
          name: 'PL 1: Bronze/Iron Age'
      - es:
          name: 'PL 1: Bronce/Edad del Hierro'
      items:
        gauntlet:
          skill: Unarmed Attack
          acc: '0'
          type: LI/O
          damage: d4+1s/d4+2s/d4-1w
          actions: '4'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '10'
          localized:
          - en:
              name: Gauntlet
              description: |-
                Armored glove that protects the hand and adds weight to punches.
          - es:
              name: Guantelete
              description: |-
                Guante blindado que protege la mano y añade peso a los golpes.
        hand-ax:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4+1w/d4+2w/d4+3w
          actions: '3'
          mass: '2'
          hide: '+2'
          avail: Any
          cost: '50'
          localized:
          - en:
              name: Hand ax
              description: A small axe that can be used in melee or thrown.
          - es:
              name: hacha de mano
              description: |-
                Un hacha pequeña que puede usarse en combate cuerpo a cuerpo o arrojarse.
        mace:
          skill: Melee-bludgeon
          acc: '0'
          type: LI/O
          damage: d6+1s/d4+1w/d6+1w
          actions: '2'
          mass: '4'
          hide: '+1'
          avail: Com
          cost: '75'
          localized:
          - en:
              name: Mace
              description: A heavy club with a metal head, designed to crush armor.
          - es:
              name: Maza
              description: |-
                Un garrote pesado con cabeza de metal, diseñado para aplastar armaduras.
        short-sword:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4w/d6w/d6+2w
          actions: '3'
          mass: '1'
          hide: '+1'
          avail: Com
          cost: '100'
          localized:
          - en:
              name: Short sword
              description: |-
                A sword with a blade length between a dagger and a longsword.
          - es:
              name: espada corta
              description: |-
                Una espada con una longitud de hoja entre una daga y una espada larga.
    pl-2-middle-ages:
      localized:
      - en:
          name: 'PL 2: Middle Ages'
      - es:
          name: 'PL 2: Edad Media'
      items:
        broad-sword:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4+2w/d6+2w/d4m
          actions: '2'
          mass: '3'
          hide: '-'
          avail: Con
          cost: '200'
          localized:
          - en:
              name: Broad sword
              description: A heavy, double-edged sword designed for cutting.
          - es:
              name: espada ancha
              description: Una espada pesada de doble filo diseñada para cortar.
        flail:
          skill: Melee-bludgeon
          acc: '+1'
          type: LI/O
          damage: d6+2s/d4+2w/d6+2w
          actions: '2'
          mass: '4'
          hide: '-'
          avail: Com
          cost: '150'
          localized:
          - en:
              name: Flail
              description: |-
                A striking weapon consisting of a stick with a swinging metal head.
          - es:
              name: Mayal
              description: |-
                Arma de golpe que consta de un palo con una cabeza de metal oscilante.
        great-ax:
          skill: Melee-blade
          acc: '+1'
          type: LI/O
          damage: d6+1w/d6+2w/d4+1m
          actions: '2'
          mass: '5'
          hide: '-'
          avail: Com
          cost: '100'
          localized:
          - en:
              name: Great ax
              description: A massive two-handed axe capable of devastating strikes.
          - es:
              name: gran hacha
              description: |-
                Un enorme hacha a dos manos capaz de realizar golpes devastadores.
        nunchaku:
          skill: Melee-bludgeon
          acc: '0'
          type: LI/O
          damage: d6s/d6+2s/d8+3s
          actions: '3'
          mass: '1'
          hide: '+2'
          avail: Com
          cost: '75'
          localized:
          - en:
              name: Nunchaku
              description: Two sticks connected by a short chain or rope.
          - es:
              name: Nunchaku
              description: Dos palos conectados por una cadena o cuerda corta.
        polearm:
          skill: Melee-blade
          acc: '+1'
          type: LI/O
          damage: d6+1w/d4+3w/d4+1m
          actions: '1'
          mass: '5'
          hide: '-'
          avail: Com
          cost: '50'
          localized:
          - en:
              name: Polearm
              description: A weapon with a long shaft and a cutting or thrusting head.
          - es:
              name: arma de asta
              description: Arma con un mango largo y una cabeza cortante o punzante.
    pl-3-age-of-reason:
      localized:
      - en:
          name: 'PL 3: Age of Reason'
      - es:
          name: 'PL 3: Edad de la Razón'
      items:
        cutlass:
          skill: Melee-blade
          acc: '+1'
          type: LI/O
          damage: d4+1w/d6+1w/d6+3w
          actions: '3'
          mass: '3'
          hide: '-'
          avail: Com
          cost: '100'
          localized:
          - en:
              name: Cutlass
              description: |-
                A short, broad sabre or slashing sword, with a straight or slightly curved blade.
          - es:
              name: Chafarote
              description: |-
                Sable o espada cortante, corta y ancha, de hoja recta o ligeramente curvada.
        katana:
          skill: Melee-blade
          acc: '-1'
          type: LI/O
          damage: d4+2w/d6+2w/d4+1m
          actions: '3'
          mass: '2'
          hide: '+1'
          avail: Con
          cost: '1000'
          localized:
          - en:
              name: Katana
              description: |-
                A traditional Japanese sword with a curved, single-edged blade.
          - es:
              name: Katana
              description: |-
                Una espada tradicional japonesa con una hoja curva y de un solo filo.
        rapier:
          skill: Melee-blade
          acc: '-1'
          type: LI/O
          damage: d4w/d4+1w/d4+2w
          actions: '3'
          mass: '2'
          hide: '+2'
          avail: Com
          cost: '300'
          localized:
          - en:
              name: Rapier
              description: |-
                A slender, sharply pointed sword, ideally used for thrusting attacks.
          - es:
              name: Estoque
              description: |-
                Una espada delgada y puntiaguda, ideal para ataques de estocada.
        saber:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4w/d4+2w/2d4+1w
          actions: '3'
          mass: '2'
          hide: '+1'
          avail: Com
          cost: '250'
          localized:
          - en:
              name: Saber
              description: A sword with a curved blade, associated with light cavalry.
          - es:
              name: Sable
              description: Espada de hoja curva, asociada a la caballería ligera.
    pl-4-industrial-age:
      localized:
      - en:
          name: 'PL 4: Industrial Age'
      - es:
          name: 'PL 4: Era industrial'
      items:
        bayonet:
          skill: Melee-blade
          acc: '+1'
          type: LI/O
          damage: d4w/d4+2w/d4m
          actions: '3'
          mass: '2'
          hide: '-'
          avail: Com
          cost: '50'
          localized:
          - en:
              name: Bayonet
              description: |-
                Originally a dagger crudely attached to a rifle's muzzle, the bayonet eventually becomes a standard attachment.<br />In effect, a bayonet turns a rifle into a spear.
          - es:
              name: Bayoneta
              description: |-
                Un cuchillo, daga, espada o arma con forma de púa diseñada para caber en el extremo del cañón de un rifle.
    pl-5-information-age:
      localized:
      - en:
          name: 'PL 5: Information Age'
      - es:
          name: 'PL 5: Era de la información'
      items:
        combat-knife:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4+1w/d4+2w/d4+3w
          actions: '4'
          mass: '1'
          hide: '+3'
          avail: Any
          cost: '35'
          localized:
          - en:
              name: Combat knife
              description: |-
                This weapon is a high-tech version of the standard dagger or knife, composed of tempered steel, sophisticated polymers, or ceramic blends. A combat knife is typically equipped with additional features:<br />A small compass can be inlaid in the handle, or a hollow handle can contain several meters of fishing line and a hook, a dozen matches, or some other suitably sized piece of survival gear.
          - es:
              name: cuchillo de combate
              description: |-
                Un cuchillo duradero diseñado para uso militar, a menudo con un borde dentado.
        stun-baton:
          skill: Melee-powered
          acc: '0'
          type: En/O
          damage: d4+1s/d4+3s/d6+4s
          actions: '3'
          mass: '2'
          hide: '+2'
          avail: Com
          cost: '300'
          localized:
          - en:
              name: Stun baton
              description: |-
                This low-powered version of the pulse baton is sometimes known as a taser. Above the insulated handle, its surface crackles with a high-voltage, low-current electrical charge that can temporarily short-circuit the human nervous system.<br />Insulated gloves are necessary to prevent the user from accidentally shocking himself. Without gloves, the user suffers Ordinary damage (d4+1s) if his Melee Attack-powered weapon skill check result is a Critical Failure.
          - es:
              name: bastón paralizante
              description: |-
                Un bastón que aplica una descarga eléctrica de alto voltaje al impactar.
    pl-6-fusion-age:
      localized:
      - en:
          name: 'PL 6: Fusion Age'
      - es:
          name: 'PL 6: Era de la fusión'
      items:
        chainsword:
          skill: Melee-powered
          acc: '+1'
          type: LI/O
          damage: d8+1w/d8+2w/d4+1m
          actions: '2'
          mass: '5'
          hide: '-'
          avail: Mil
          cost: '1500'
          localized:
          - en:
              name: Chainsword
              description: |-
                This device consists of a meter-long blade either built into a heavy forearm gauntlet and power supply or a standard weapon hilt. The blade is edged with a molecule-thin razor of super-tough artificial crystals, driven in chainsaw fashion along the weapon's edge.<br />This provides a powerful cutting edge and a particularly lethal melee weapon.
          - es:
              name: Espada sierra
              description: |-
                Una espada con dientes motorizados que giran como una motosierra.
        pulse-baton:
          skill: Melee-powered
          acc: '0'
          type: En/O
          damage: d8s/d4+2w/d6+2w
          actions: '3'
          mass: '2'
          hide: '+2'
          avail: Con
          cost: '500'
          localized:
          - en:
              name: Pulse baton
              description: |-
                The first powered melee weapon capable of inflicting lethal damage, the pulse baton is a half-meter-long rod that delivers a concentrated energy discharge when it hits a target.<br />While the baton appears to be a simple flashlight, the operator must wear a pair of insulated gloves to prevent an accidental discharge.
          - es:
              name: Bastón de pulso
              description: |-
                Un bastón que emite un pulso cinético al impactar, causando daños internos.
    pl-7-gravity-age:
      localized:
      - en:
          name: 'PL 7: Gravity Age'
      - es:
          name: 'PL 7: Era de la gravedad'
      items:
        gravmace:
          skill: Melee-powered
          acc: '0'
          type: LI/O
          damage: d8+2s/d6+2w/d8+2w
          actions: '3'
          mass: '3'
          hide: '-'
          avail: Con
          cost: '850'
          localized:
          - en:
              name: Gravmace
              description: |-
                The gravmace consists of a meter-long handle with a gravitonic capacitor inside a striking head. Powerful capacitors manipulate the weapon's mass, making it strike like a sledgehammer while being swung like a willow switch.
          - es:
              name: Gravmace
              description: |-
                Una maza que utiliza generadores de gravedad para aumentar la fuerza del impacto.
        power-cestus:
          skill: Unarmed-brawl
          acc: '0'
          type: LI/O
          damage: d4+2s/d4w/d4+1w
          actions: '4'
          mass: '3'
          hide: '+1'
          avail: Con
          cost: '500'
          localized:
          - en:
              name: Power cestus
              description: |-
                The power cestus consists of an elbow-length gauntlet of CF (carbonate fiber) weave, ending in a heavy fighting glove that covers the user's hand. Gravity technology allows the wielder to strike blows of astonishing power with a gloved hand.
          - es:
              name: Cestus de poder
              description: Un guantelete motorizado que mejora los ataques sin armas.
        samurai-300-ion-blade:
          skill: Melee-powered
          acc: '0'
          type: En/O
          damage: d4+3s/d6+4s/d4+3w
          actions: '4'
          mass: '2.25'
          hide: '+2'
          avail: Mil
          cost: '750'
          localized:
          - en:
              name: Samurai 300 Ion Blade
              description: |-
                The ion blade delivers a discharge of electromagnetic energy on contact. While it's moderately effective against unarmored targets, its primary purpose is to neutralize heavy body armor, robots, and cybernetics. A target that relies on electronic control systems or computers suffers a +2 step penalty to any Stamina-endurance checks he (or it) must make after being struck by an ion blade.
          - es:
              name: Hoja Iónica Samurai 300
              description: |-
                La hoja iónica emite una descarga de energía electromagnética al contacto. Aunque es moderadamente efectiva contra objetivos sin armadura, su propósito principal es neutralizar armaduras pesadas, robots y equipo cibernético. Un objetivo que dependa de sistemas de control electrónico o computadoras sufre un penalizador de +2 pasos a cualquier control de Destreza y Resistencia que deba hacer tras ser impactado.
        nighthawk-a5-pulse-baton:
          skill: Melee-powered
          acc: '0'
          type: En/O
          damage: d8s/d4+2w/d6+2w
          actions: '3'
          mass: '1.15'
          hide: '+4'
          avail: Con
          cost: '500'
          localized:
          - en:
              name: Nighthawk A5 Pulse Baton
              description: |-
                Pulse batons have been in use for more than a century. Few unarmored targets can stand up to more than one or two shocks from its powerful capacitors. The Nighthawk is a telescoping stealth model made from low-density plastics. It's extremely concealable and does not show up on most weapon detectors, allowing the user to smuggle it into places he might not normally be armed.
          - es:
              name: Bastón de Pulsos Nighthawk A5
              description: |-
                Los bastones de pulsos se han usado por más de un siglo. Pocos objetivos sin armadura pueden resistir más de uno o dos choques de sus potentes capacitores. El Nighthawk es un modelo sigiloso telescópico hecho de plástico de baja densidad. Es muy fácil de ocultar y no aparece en la mayoría de detectores de armas, permitiendo al usuario introducirlo de contrabando en lugares donde normalmente no podría ir armado.
        punkthumper-6000-stun-baton:
          skill: Melee-powered
          acc: '0'
          type: En/O
          damage: d6+1s/d8+2s/d12+3s
          actions: '3'
          mass: '2'
          hide: '+2'
          avail: Com
          cost: '425'
          localized:
          - en:
              name: PunkThumper 6000 Stun Baton
              description: |-
                Hundreds of models of stun batons are available, but Merrick's awards its prestigious Triple-Bullseye rating to the PunkThumper 6000 as the best of its class. Intended for serious restraint work, the PT 6K uses an extra-heavy pulse baton battery to deliver the biggest stun-sized jolt around. It doesn't last as long as a standard stun baton's charge, but with the PunkThumper each hit counts.
          - es:
              name: Bastón Aturdidor PunkThumper 6000
              description: |-
                Existen cientos de modelos de bastones aturdidores, pero Merrick otorga su máxima calificación al PunkThumper 6000 como el mejor de su clase. Destinado a trabajos de restricción en serio, usa una batería extrapesada para dar la mayor sacudida posible. No dura tanto como una carga normal de bastón aturdidor, pero con este bastón cada golpe cuenta.
        ax2-chainsword:
          skill: Melee-powered
          acc: '+1'
          type: LI/G
          damage: d8+1w/d8+2w/d4+1m
          actions: '2'
          mass: '7'
          hide: '-'
          avail: Mil
          cost: '1250'
          localized:
          - en:
              name: AX2 Chainsword
              description: |-
                The chainsword is heavy and unwieldy, but it delivers outstanding damage in hand-to-hand combat. Its fighting edge is a chain-driven array of serrated, microengineered teeth, capable of cutting through almost any normal material. (In fact, the chainsword serves as a decent concrete saw in a pinch.) The AX2 is a heavy-duty model designed for use against heavily armored targets.
          - es:
              name: Espada Sierra AX2
              description: |-
                La espada sierra es pesada y torpe, pero causa un daño extremo cuerpo a cuerpo. Su filo es una cadena dentada microingenierizada capaz de aserrar casi cualquier material normal. El AX2 es un modelo diseñado para usarse contra objetivos muy blindados.
        viper-d-filament-blade:
          skill: Melee-powered
          acc: '0'
          type: LI/O
          damage: d8-1w/d8w/d12-1w
          actions: '3'
          mass: '1.75'
          hide: '+2'
          avail: Con
          cost: '1500'
          localized:
          - en:
              name: Viper D Filament Blade
              description: |-
                A filament blade's fighting edge is a single strand of monomolecular carbonate fiber. The weapon consists of a hilt and a small, free-floating lead module, between which the monofilament is stretched. The lead module senses the user's swings and maneuvers accordingly, keeping the filament taut at all times. The weapon can be set for a length of up to 4 meters for melee attacks against distant targets.
          - es:
              name: Hoja de Filamento Viper D
              description: |-
                El arma consta de una empuñadura y un pequeño módulo de plomo con una hebra continua de carbonato monomolecular conectándolos. El módulo detecta el balanceo del usuario y mantiene el filamento tenso en todo momento. Puede ajustarse a una longitud de hasta 4 metros para ataques cuerpo a cuerpo contra objetivos distantes.
        t-bar-tn-blade:
          skill: Melee-blade
          acc: '0'
          type: LI/G
          damage: d6w/d6+1w/d4m
          actions: '4'
          mass: '4'
          hide: '+3'
          avail: Com
          cost: '500'
          localized:
          - en:
              name: T-Bar TN Blade
              description: |-
                TN stands for tungsten-neutronite. It's the toughest conventional alloy known, capable of punching through cerametal or vanadium steel like an iron crowbar through tin foil. This weapon is a large combat knife, but it's far denser (and heavier) than a conventional blade. The TN knife is the only nonpowered weapon capable of piercing powered attack armors such as the body tank.
          - es:
              name: Hoja TN T-Bar
              description: |-
                TN significa tungsteno-neutronita. Es la aleación más dura conocida, capaz de perforar cerametal como palanca a través de aluminio. Esta arma es un gran cuchillo de combate, pero mucho más densa (y pesada) que una cuchilla convencional. Es la única arma no energizada capaz de penetrar armaduras como el tanque corporal.
        thunder-150-gravmace:
          skill: Melee-powered
          acc: '0'
          type: LI/O
          damage: d8+2s/d6+2w/d8+2w
          actions: '3'
          mass: '3'
          hide: '+1'
          avail: Con
          cost: '850'
          localized:
          - en:
              name: Thunder 150 Gravmace
              description: |-
                The gravity mace (or gravmace, as it's more commonly known) is a popular weapon among many front-line assault troops. It's lighter and faster than the chainsword, and even if it lacks the chainsword's hitting power, the gravmace's combat battery lasts twice as long. The Thunder 150 is a standard model found in the inventory of several stellar nations and a number of private security firms.
          - es:
              name: Gravimaza Thunder 150
              description: |-
                La maza de gravedad es un arma popular entre tropas de asalto de primera línea. Es más ligera y rápida que una turbosierra, y aunque carece de su impacto destructor, su batería dura el doble. El Thunder 150 es el modelo estándar en varias naciones estelares y firmas de seguridad privada.
        headbuster-power-cestus:
          skill: Unarmed Attack
          acc: '0'
          type: LI/O
          damage: d4+2s/d4w/d4+2w
          actions: '4'
          mass: '2'
          hide: '+3'
          avail: Con
          cost: '625'
          localized:
          - en:
              name: HeadBuster Power Cestus
              description: |-
                Winner of the Merrick's Triple-Bullseye, the HeadBuster is the best power cestus available. It's lighter and more concealable than most power cesti, but provides the same hitting power. The HeadBuster is so easy to use that most wielders require no formal training in powered weapons; the wielder can choose to use either his Melee Weapons or Unarmed Attack skill when attacking with the HeadBuster.
          - es:
              name: Cestus de Energía HeadBuster
              description: |-
                Ganador del premio de Triple-Bullseye de Merrick, es el mejor cestus de energía disponible. Es más ligero y ocultable que sus rivales, pero da el mismo poder de impacto. Es tan fácil de usar que puedes elegir usar tu habilidad de Armas Cuerpo a Cuerpo o Ataques Desarmados al golpear con el HeadBuster.
        k-3-zero-g-axe:
          skill: Melee-powered
          acc: '+1'
          type: LI/O
          damage: d6+2w/d4+4w/d4+2m
          actions: '3'
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '950'
          localized:
          - en:
              name: K-3 Zero-G Axe
              description: |-
                The zero-g axe is a powered weapon specialized for use in boarding actions and microgravity situations. At the bottom of its haft, a counterweight compensates perfectly for the variable mass of its deadly carbonite blade. The weapon negates two steps of light-gravity or zero-g combat penalties, allowing a user with magnetic boots or the Acrobatics-zero-g training skill to make melee attacks with no penalty.
          - es:
              name: Hacha Gravedad Cero K-3
              description: |-
                El hacha de gravedad cero es un arma energizada especializada para acciones de abordaje y situaciones de microgravedad. En la base de su mango, un contrapeso compensa la masa variable de su letal hoja. Anula dos niveles de penalizadores de combate de gravedad cero o ligera, permitiendo el combate cuerpo a cuerpo libre de penalizaciones para alguien entrenado.
        chuurkhna:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4+3w/d6+3w/d6m
          actions: '3'
          mass: '7'
          hide: '-'
          avail: Com
          cost: '350'
          localized:
          - en:
              name: Chuurkhna
              description: |-
                An ancient weren design, the chuurkhna is still favored by members of that race. It's a glaive or halberd with a haft about a meter and a half long. Its blade is large and heavy, intended for chopping rather than thrusting. A weren can wield it one- or two-handed, but most humans would have to use both hands to control it. Weren have been known to drive chuurkhnas through the heaviest body armor.
          - es:
              name: Chuurkhna
              description: |-
                Un antiguo diseño weren, aún preferida por miembros de la raza. Es una guja o alabarda con un mango de metro y medio. Su hoja es grande y pesada, diseñada para cortar en lugar de apuñalar. Los weren la blanden a 1 o 2 manos pero la mayoría de los humanos necesitarían ambas manos. Tienen la fama de perforar la armadura más pesada.
        dait-sya:
          skill: Melee-blade
          acc: '0'
          type: LI/O
          damage: d4+1w/d4+2w/d4+3w
          actions: '4'
          mass: '1'
          hide: '+2'
          avail: Com
          cost: '250'
          localized:
          - en:
              name: Dait'sya
              description: |-
                The dait'sya is a traditional t'sa weapon, a double-bladed dagger held in the wielder's closed fist. They're always used in pairs (the listed cost, mass, and damage is for two weapons). Combined with the lightning speed of most t'sa, the dait'sya is especially dangerous in close-quarters combat. Because of the dait'sya's light design, any penalties for fighting with a weapon in each hand are reduced by 1 step.
          - es:
              name: Dait'sya
              description: |-
                El dait'sya es un arma tradicional t'sa de doble cuchilla empuñada a puño cerrado y siempre usadas en pares (precio, masa y estadísticas representan las dos). En combinación con la velocidad t'sa, la dait'sya es muy peligrosa en distancias cortas. Su ligereza disminuye cualquier penalización de pelear con un arma a cada mano en 1 paso.
        tong-fe:
          skill: Melee-bludgeon / Unarmed Attack
          acc: '-1'
          type: LI/O
          damage: d6s/d6+2s/d4+1w
          actions: '4'
          mass: '1'
          hide: '+2'
          avail: Com
          cost: '60'
          localized:
          - en:
              name: Tong Fe
              description: |-
                The tong fe is a martial arts weapon that has become the fighting stick of choice for many police and security forces. Designed specifically for parrying, the tong fe adds a -2 step bonus to any parrying effort the user attempts. As with the dait'sya, experts often wield two of these weapons at once; the tong fe reduces the penalties for attacking with two weapons at once by 1 step.
          - es:
              name: Tong Fe
              description: |-
                El tong fe es un arma de artes marciales popular entre patrullaje policial. Hecha para reflejar ataques, otorga un bonus de -2 pasos a cualquier intento de parada (parry). Al igual que con la dait'sya, a menudo son blandidos en equipo; el tong fe disminuye las penalizaciones por atacar con armas a dos manos un total de 1 paso.
    pl-8-energy-age:
      localized:
      - en:
          name: 'PL 8: Energy Age'
      - es:
          name: 'PL 8: Era Energética'
      items:
        star-sword:
          skill: Melee-powered
          acc: '0'
          type: En/G
          damage: d6+1w/2d6w/d4+3m
          actions: '3'
          mass: '2'
          hide: '+2'
          avail: Res
          cost: '7000'
          localized:
          - en:
              name: Star sword
              description: |-
                The star sword generates a complex, phased magnetic field in the rough shape of a sword blade, and then fills the interior of this field with white-hot plasma.<br />On contact, the containment field releases a stream of plasma that can burn or cut through almost anything.
          - es:
              name: espada estrella
              description: Una espada con una hoja de energía de plasma contenida.
        tri-staff:
          skill: Melee-powered
          acc: '-1'
          type: En/O
          damage: d8+2w/3d4+1w/d6m
          actions: '3'
          mass: '3'
          hide: '-'
          avail: Res
          cost: '4000'
          localized:
          - en:
              name: Tri-staff
              description: |-
                This 2-meter-long staff is topped by a three-pronged blade. When the staff is activated, an internal power source suffuses it with a soft glow. This aura acts as a defensive force field that improves the Strength and Dexterity resistance modifiers of its wielder by 1 step.
          - es:
              name: triple personal
              description: |-
                Un bastón de tres secciones con emisores de energía en cada extremo.
ranged:
  config:
    default:
      columns:
        en:
        - name: Weapon
          key: name
        - name: Skill
          key: skill
        - name: Acc
          key: acc
        - name: Md
          key: md
        - name: Range (S/M/L)
          key: range
        - name: Type
          key: type
        - name: Damage (O/G/A)
          key: damage
        - name: Act.
          key: act
        - name: Clip
          key: clip
        - name: Mass
          key: mass
        - name: Hide
          key: hide
        - name: Avail
          key: avail
        - name: Cost ($)
          key: cost
        - name: Description
          key: description
          hidden: true
        es:
        - name: Arma
          key: name
        - name: Habilidad
          key: skill
        - name: Acc
          key: acc
        - name: Rango (P/M/L)
          key: range
        - name: Daño (O/G/A)
          key: damage
        - name: Acto.
          key: act
        - name: Acortar
          key: clip
        - name: Costo ($)
          key: cost
        - name: Descripción
          key: description
          hidden: true
        - name: Costo del clip
          key: clip_cost
          hidden: true
        - name: Esconder
          key: hide_modifier
          hidden: true
  items:
    pl-0-stone-age:
      localized:
      - en:
          name: 'PL 0: Stone Age'
      - es:
          name: 'PL 0: Edad de Piedra'
      items:
        bow-short:
          skill: Prim-bow
          acc: '+1'
          md: F
          range: 20/40/100
          type: LI/O
          damage: d4w/d4+2w/d4+3w
          act: '3'
          clip: '10'
          mass: '1'
          hide: '-'
          avail: Any
          cost: '100'
          localized:
          - en:
              name: Bow, short
              description: |-
                This is a simple bow made from a single piece of wood. Because archery and bowhunting exist as sports, short bows made of high-tech materials may be readily available at higher Progress Levels.
          - es:
              name: Arco, corto
              description: |-
                Un arco sencillo fabricado a partir de una sola pieza de madera.
        sling:
          skill: Prim-sling
          acc: '+1'
          md: F
          range: 10/20/60
          type: LI/O
          damage: d4s/d4+2s/d4w
          act: '2'
          clip: '10'
          mass: '0.1'
          hide: '-'
          avail: Any
          cost: '25'
          localized:
          - en:
              name: Sling
              description: |-
                This weapon is a simple looped strap in which a stone is whirled and then let fly. Small stones originally serve as ammunition, but the sling at PL 2 and higher uses metal bullets, whose aerodynamic shape increases the sling's range by 10 meters in each category.
          - es:
              name: Honda
              description: |-
                Correa con bucle que se utiliza para arrojar piedras o balas de plomo.
    pl-1-bronze-iron-age:
      localized:
      - en:
          name: 'PL 1: Bronze/Iron Age'
      - es:
          name: 'PL 1: Bronce/Edad del Hierro'
      items:
        javelin:
          skill: Athl-throw
          acc: '0'
          md: F
          range: Per STR
          type: LI/O
          damage: d4w/d4+1w/d4+2w
          act: '1'
          clip: '1'
          mass: '1'
          hide: '-'
          avail: Com
          cost: '50'
          localized:
          - en:
              name: Javelin
              description: |-
                A light throwing spear, sometimes fashioned from metal, the javelin was often used in hunting. Its balance and mass make it an ideal throwing weapon, increasing the wielder's normal throwing range by 50 percent.
          - es:
              name: Jabalina
              description: Una lanza ligera diseñada principalmente para ser arrojada.
    pl-2-middle-ages:
      localized:
      - en:
          name: 'PL 2: Middle Ages'
      - es:
          name: 'PL 2: Edad Media'
      items:
        bow-long:
          skill: Prim-bow
          acc: '+1'
          md: F
          range: 40/80/200
          type: LI/O
          damage: d4+1w/d6+1w/d4m
          act: '2'
          clip: '10'
          mass: '1'
          hide: '-'
          avail: Com
          cost: '200'
          localized:
          - en:
              name: Bow, long
              description: |-
                A famous weapon, the long bow actually exceeds the PL 3 flintlock rifle in range, accuracy, and rate of fire and does nearly as much damage. The long bow remained the weapon of choice for many soldiers long after the advent of firearms.
          - es:
              name: Arco, largo
              description: Un arco alto aproximadamente igual a la altura del usuario.
        crossbow:
          skill: Prim-bow
          acc: '0'
          md: F
          range: 50/100/250
          type: LI/O
          damage: d4+2w/d6+2w/d4+1m
          act: '1'
          clip: '1'
          mass: '2'
          hide: '-'
          avail: Con
          cost: '400'
          localized:
          - en:
              name: Crossbow
              description: |-
                Consisting of a bow mounted crosswise on a wooden or metal stock, the crossbow is fired much like a gun. Although slower and clumsier than a long bow, it outranges the bow and has superior striking power.
          - es:
              name: Ballesta
              description: Arco montado sobre una culata que dispara virotes o virotes.
        shuriken:
          skill: Athl-throw
          acc: '+2'
          md: F
          range: Per STR
          type: LI/O
          damage: d4s/d4w/d4+1w
          act: '4'
          clip: '1'
          mass: '0.1'
          hide: '+4'
          avail: Com
          cost: '10'
          localized:
          - en:
              name: Shuriken
              description: |-
                Though these "throwing stars" are not extremely lethal, the metal, sharp-pointed disks are easy to conceal.
          - es:
              name: shuriken
              description: Arma oculta que generalmente se arroja.
    pl-3-age-of-reason:
      localized:
      - en:
          name: 'PL 3: Age of Reason'
      - es:
          name: 'PL 3: Edad de la Razón'
      items:
        musket-flintlock:
          skill: Prim-flint
          acc: '+2'
          md: F
          range: 20/40/100
          type: HI/O
          damage: d6+1w/d6+3w/d6+1m
          act: '1'
          clip: '1'
          mass: '4'
          hide: '-'
          avail: Com
          cost: '350'
          localized:
          - en:
              name: Musket, flintlock
              description: |-
                The musket was the most successful of the black powder weapons. By later standards it is inaccurate and unreliable, but its 50 to 60 caliber bullet deserves respect.
          - es:
              name: Mosquete, llave de chispa
              description: |-
                Un arma larga con avancarga que utiliza un mecanismo de chispa.
        pistol-flintlock:
          skill: Prim-flint
          acc: '+2'
          md: F
          range: 4/8/16
          type: HI/O
          damage: d4+2w/d6+2w/d4+1m
          act: '2'
          clip: '1'
          mass: '2'
          hide: '+2'
          avail: Com
          cost: '200'
          localized:
          - en:
              name: Pistol, flintlock
              description: |-
                The flintlock pistol employs the same mechanism and muzzle-loading powder and shot as the flintlock musket.
          - es:
              name: Pistola, llave de chispa
              description: |-
                Una pistola con avancarga que utiliza un mecanismo de chispa.
        rifle-long:
          skill: Prim-flint
          acc: '+1'
          md: F
          range: 30/60/150
          type: HI/O
          damage: d6w/d6+2w/d6m
          act: '1'
          clip: '1'
          mass: '5'
          hide: '-'
          avail: Com
          cost: '500'
          localized:
          - en:
              name: Rifle, long
              description: |-
                Also known as a Kentucky rifle, this flintlock weapon was more accurate than the musket, but fired a smaller ball.
          - es:
              name: Rifle, largo
              description: |-
                Un arma larga con un cañón estriado para mejorar la precisión.
    pl-4-industrial-age:
      localized:
      - en:
          name: 'PL 4: Industrial Age'
      - es:
          name: 'PL 4: Era industrial'
      items:
        derringer:
          skill: Mod-pistol
          acc: '+1'
          md: F
          range: 2/6/12
          type: HI/O
          damage: d4-1w/d6w/d6+2w
          act: '2'
          clip: '2'
          mass: '0.25'
          hide: '+4'
          avail: Com
          cost: '100'
          localized:
          - en:
              name: Derringer
              description: |-
                The smallest pistols ever made, these weapons appeared with flintlock actions early in the 19th century but didn't become popular until the 1870s.
          - es:
              name: derringer
              description: Una pistola pequeña y fácilmente ocultable.
        pistol-32-rev:
          skill: Mod-pistol
          acc: '+1'
          md: F
          range: 4/8/30
          type: HI/O
          damage: d4w/d6w/d4m
          act: '3'
          clip: '6'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '200'
          localized:
          - en:
              name: Pistol, .32 rev.
              description: |-
                Light revolvers and small handguns are in common use for centuries after their invention. The small size of the .32 caliber makes it ideal for concealment in a hidden holster or pocket.
          - es:
              name: Pistola, .38 rev
              description: |-
                Un revólver confiable de seis tiros con recámara de calibre .38.
        pistol-45-rev:
          skill: Mod-pistol
          acc: '+1'
          md: F
          range: 4/10/40
          type: HI/O
          damage: d4+1w/d4+2w/d6m
          act: '3'
          clip: '6'
          mass: '1'
          hide: '+2'
          avail: Com
          cost: '250'
          localized:
          - en:
              name: Pistol, .45 rev.
              description: |-
                A heavier pistol, it's not quite as easy to conceal as the .32, but delivers greater damage and has longer range.
          - es:
              name: Pistola, .44 magnum
              description: Un poderoso revólver conocido por su poder de detención.
        rifle-30-bolt:
          skill: Mod-rifle
          acc: '0'
          md: F
          range: 50/100/300
          type: HI/O
          damage: d4+2w/d6+2w/d4+1m
          act: '1'
          clip: '10'
          mass: '3'
          hide: '-'
          avail: Mil
          cost: '500'
          localized:
          - en:
              name: Rifle, .30 bolt
              description: |-
                A common infantry weapon, the bolt-action rifle is accurate, but tends to be slow-firing and heavy.
          - es:
              name: Rifle, 7,62 mm
              description: |-
                Un rifle de cerrojo o semiautomático que dispara un cartucho pesado.
        rifle-44-lever:
          skill: Mod-rifle
          acc: '+1'
          md: F
          range: 40/80/240
          type: HI/O
          damage: d6w/d8+1w/d6m
          act: '2'
          clip: '12'
          mass: '3'
          hide: '-'
          avail: Com
          cost: '400'
          localized:
          - en:
              name: Rifle, .44 lever
              description: |-
                Introduced early in the Industrial Age, repeating rifles such as this weapon were common in the Old West, mainly among hunters and frontiersmen.
          - es:
              name: fusil, asalto
              description: |-
                Un rifle de fuego selectivo que utiliza un cartucho intermedio.
        shotgun-12-gauge:
          skill: Mod-rifle
          acc: '0'
          md: F
          range: 6/12/30
          type: HI/O
          damage: d4w/d6w/d4m
          act: '2'
          clip: '5'
          mass: '4'
          hide: '+7'
          avail: Com
          cost: '500'
          localized:
          - en:
              name: Shotgun, 12 gauge
              description: |-
                Shotguns come in several different forms, including pump-action, bolt-action, single-shot, and double-barrel. The 12 gauge is a fairly typical pump-action shotgun.<br />Damage from a shotgun is highly dependent on range. At short range, damage is doubled. At long range, all damage results are halved (round down, to a minimum of 1 point).
          - es:
              name: Subfusil, 9 mm
              description: Una metralleta que dispara munición de pistola de 9 mm.
        smg-45-cal:
          skill: Mod-SMG
          acc: '+2'
          md: B/A
          range: 8/16/40
          type: HI/O
          damage: d4+1w/d4+2w/d6m
          act: '4'
          clip: -/8
          mass: '4'
          hide: '-'
          avail: Con
          cost: '600'
          localized:
          - en:
              name: SMG, .45 cal
              description: |-
                Popularly known as the "tommy gun," this weapon came into use near the end of the Industrial Age. It was the first of the personal automatic weapons, with the ability to damage more than one target in a single attack. That property made it a highly desirable firearm despite its relatively poor accuracy.
          - es:
              name: SMG, .45 cal
              description: |-
                Popularly known as the "tommy gun," this weapon came into use near the end of the Industrial Age. It was the first of the personal automatic weapons, with the ability to damage more than one target in a single attack. That property made it a highly desirable firearm despite its relatively poor accuracy.
    pl-5-information-age:
      localized:
      - en:
          name: 'PL 5: Information Age'
      - es:
          name: 'PL 6: Era de la fusión'
      items:
        pistol-38-rev:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 6/12/40
          type: HI/O
          damage: d4w/d4+1w/d4m
          act: '3'
          clip: '6'
          mass: '1'
          hide: '+2'
          avail: Com
          cost: '100'
          localized:
          - en:
              name: Pistol, .38 rev
              description: |-
                This medium revolver comes into widespread use because of its relatively low cost as well as its slightly improved range.
          - es:
              name: Pistola, canal de 9 mm.
              description: |-
                Una pistola que utiliza munición cargada eléctricamente para aumentar la velocidad.
        pistol-44-magnum:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 6/12/50
          type: HI/O
          damage: d4+2w/d4+3w/d4+2m
          act: '3'
          clip: '6'
          mass: '1'
          hide: '+1'
          avail: Com
          cost: '450'
          localized:
          - en:
              name: Pistol, .44 magnum
              description: |-
                The most powerful handgun of the 20th century, this formidable weapon is renowned for its hitting power.
          - es:
              name: Pistola, 9 mm de gravedad cero
              description: |-
                Una pistola sin retroceso diseñada para usar en entornos de gravedad cero.
        pistol-9mm:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 6/12/50
          type: HI/O
          damage: d4+1w/d4+2w/d4m
          act: '4'
          clip: '15'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '300'
          localized:
          - en:
              name: Pistol, 9mm
              description: |-
                Smaller but deadlier than the .38, the 9mm is an extremely popular handgun in the second half of the Information Age. A high-capacity ammo clip and a rapid rate of fire combine to produce an approximation of autofire, although the pistol is incapable of fully automatic action.
          - es:
              name: Pistola, canal de 11 mm.
              description: Un disparo de pistola pesada cargó balas de 11 mm.
        rifle-7-62mm:
          skill: Mod-rifle
          acc: '0'
          md: F
          range: 70/140/350
          type: HI/O
          damage: d6+1w/2d4+1w/d4+1m
          act: '3'
          clip: '10'
          mass: '4'
          hide: '-'
          avail: Con
          cost: '1000'
          localized:
          - en:
              name: Rifle, 7.62mm
              description: |-
                The main battle rifle of the mid-20th century, the 7.62 remains a favorite of marksmen long after lighter, full-automatic weapons supersede it on the battlefield.
          - es:
              name: Rifle, canal de 11 mm
              description: |-
                Un rifle militar estándar que disparaba balas cargadas de 11 mm.
        rifle-assault:
          skill: Mod-rifle
          acc: '0'
          md: F/B/A
          range: 60/120/300
          type: HI/O
          damage: d4+2w/d6+3w/d4+1m
          act: '4'
          clip: 30/10
          mass: '3'
          hide: '-'
          avail: Mil
          cost: '1500'
          localized:
          - en:
              name: Rifle, assault
              description: |-
                The assault rifle—the first firearm capable of both burst mode and autofire—is the standard military weapon of the era. Its range and damage are superior to anything that has come before it.
          - es:
              name: Rifle, 11 mm de gravedad cero
              description: |-
                Un rifle sin retroceso diseñado para combates en gravedad cero.
        smg-9mm:
          skill: Mod-SMG
          acc: '+1'
          md: B/A
          range: 10/20/80
          type: HI/O
          damage: d4+1w/d4+2w/d4m
          act: '4'
          clip: -/10
          mass: '3'
          hide: '+1'
          avail: Con
          cost: '1200'
          localized:
          - en:
              name: SMG, 9mm
              description: |-
                A whole family of small but deadly automatic weapons with astounding rates of fire fall into this category. The submachine gun is an outstanding weapon in a close-in fight, but can't match a rifle for range or accuracy.
          - es:
              name: Escopeta, autoflec
              description: |-
                Una escopeta que dispara balas de flechette para causar daños en áreas amplias.
    pl-6-fusion-age:
      localized:
      - en:
          name: 'PL 6: Fusion Age'
      - es:
          name: 'PL 7: Era de la gravedad'
      items:
        pistol-9mm-ch:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 8/16/60
          type: HI/O
          damage: d4+1w/d6+1w/d4m
          act: '4'
          clip: '15'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '400'
          localized:
          - en:
              name: Pistol, 9mm ch
              description: |-
                In this weapon, the firing pin and chemical explosive combination of a PL 5 firearm is replaced by a powerful contact delivering a massive shock to the cartridge, which is powered by an electrochemical propellant. On firing, the propellant is converted into a white-hot plasma that expands more powerfully and smoothly than a chemical explosive. The result is a weapon that fires a slug with much higher muzzle velocity than earlier firearms.
          - es:
              name: Pistola, sabot de 15 mm
              description: Una pistola pesada que dispara balas de sabot perforantes.
        pistol-9mm-zero-g:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 4/10/40
          type: HI/O
          damage: d4+1w/d6+1w/d4m
          act: '2'
          clip: '15'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '500'
          localized:
          - en:
              name: Pistol, 9mm zero-g
              description: |-
                This charge pistol has a sophisticated anti-recoil system to neutralize the gun's movement. It allows the user to fire the weapon in weightless conditions without throwing himself into awkward tumbles or turns.
          - es:
              name: Pistola, láser
              description: Una pistola que dispara un rayo de luz enfocado.
        pistol-11mm-ch:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 10/20/80
          type: HI/O
          damage: d4+2w/d6+2w/d4+1m
          act: '4'
          clip: '10'
          mass: '1.2'
          hide: '+2'
          avail: Con
          cost: '800'
          localized:
          - en:
              name: Pistol, 11mm ch
              description: |-
                This is a heavier version of the 9mm charge pistol, firing a larger round.
          - es:
              name: Pistola, masa
              description: |-
                Una pistola que utiliza campos de gravedad para acelerar proyectiles.
        rifle-11mm-ch:
          skill: Mod-rifle
          acc: '0'
          md: F/B/A
          range: 80/160/400
          type: HI/O
          damage: d6+1w/d6+3w/d6+1m
          act: '4'
          clip: 30/10
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '1500'
          localized:
          - en:
              name: Rifle, 11mm ch
              description: |-
                The standard 11mm charge rifle features the electrochemical firing system described above for the charge pistol, but includes an automatic mode.
          - es:
              name: Pistola, tartamudeo
              description: Una pistola no letal que altera el sistema nervioso.
        rifle-11mm-zero-g:
          skill: Mod-rifle
          acc: '0'
          md: F
          range: 30/60/200
          type: HI/O
          damage: d6+1w/d6+3w/d6+1m
          act: '4'
          clip: '15'
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '1800'
          localized:
          - en:
              name: Rifle, 11mm zero-g
              description: |-
                Like the zero-g pistol, this rifle fires standard charge rounds with a special anti-recoil system to neutralize its kick.
          - es:
              name: rifle, láser
              description: Un rifle que dispara un rayo láser de alta potencia.
        shotgun-autoflec:
          skill: Mod-rifle
          acc: '0'
          md: F/B/A
          range: 10/20/40
          type: HI/O
          damage: d4w/d6w/d4m
          act: '4'
          clip: 15/5
          mass: '3'
          hide: '+1'
          avail: Mil
          cost: '2500'
          localized:
          - en:
              name: Shotgun, autoflec
              description: |-
                The autoflechette gun fires a 25mm round that contains a bundle of tiny, razor-sharp aerofoils. A single hit can carve an unarmored person to ribbons, but the autoflechette gun can also be used in full automatic mode with a rate of fire equal to that of most submachine guns—thus, it can clean out a roomful of targets with a few bursts.<br />Like the standard shotgun, damage from the autoflechette is highly dependent on range. At short range, damage is doubled. At long range, damage rolls are halved (round down, to a minimum of 1 point).
          - es:
              name: fusil, masa
              description: |-
                Un rifle que utiliza campos de gravedad para acelerar proyectiles.
        smg-9mm-ch:
          skill: Mod-SMG
          acc: '+1'
          md: B/A
          range: 20/40/100
          type: HI/O
          damage: d4+1w/d6+1w/d4m
          act: '4'
          clip: -/10
          mass: '3'
          hide: '+1'
          avail: Mil
          cost: '1500'
          localized:
          - en:
              name: SMG, 9mm ch
              description: |-
                This weapon combines electrochemical charge technology with full automatic action.
          - es:
              name: Rifle, cuántico
              description: Un rifle que manipula estados cuánticos para causar daño.
    pl-7-gravity-age:
      localized:
      - en:
          name: 'PL 7: Gravity Age'
      - es:
          name: 'PL 8: Era Energética'
      items:
        pistol-15mm-sabot:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 10/20/100
          type: HI/O
          damage: 2d4w/2d4+1w/d4+3m
          act: '3'
          clip: '6'
          mass: '2'
          hide: '-'
          avail: Con
          cost: '900'
          localized:
          - en:
              name: Pistol, 15mm sabot
              description: |-
                This small, handheld electromagnetic accelerator hurls a special, discarding-rocket slug at hypersonic velocities.<br />The round fired by this weapon is a miniature scramjet that ignites soon after leaving the muzzle and quickly accelerates to incredible speed. Due to its extremely high velocity, the rocket round is designed to splatter against any appreciable resistance to transfer as much kinetic energy as possible to the target.
          - es:
              name: Automaser
              description: Un arma máser de fuego rápido.
        pistol-laser:
          skill: Mod-pistol
          acc: '-1'
          md: F
          range: 20/40/200
          type: En/O
          damage: d4+1w/d6+1w/d4m
          act: '4'
          clip: '20'
          mass: '1'
          hide: '+3'
          avail: Con
          cost: '1000'
          localized:
          - en:
              name: Pistol, laser
              description: |-
                Another application of electrochemical technology, the laser weapon uses an electrical charge to raise a chemical mass to brilliant fluorescence. This light is focused through precisely machined artificial crystals and expelled from the weapon as a white-hot beam.
          - es:
              name: Pistola, máser hvy
              description: Una pistola pesada que dispara un láser de microondas.
        pistol-mass:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 2/6/12
          type: En/G
          damage: d6w/d6+2w/d6m
          act: '4'
          clip: '2'
          mass: '1'
          hide: '+2'
          avail: Mil
          cost: '1200'
          localized:
          - en:
              name: Pistol, mass
              description: |-
                Utilizing the gravity induction technology also employed in shipboard weapons systems, the mass pistol throws an artificial, short-lived mass singularity at its target. This gravity point causes horrible damage through tidal effects to both animate and inanimate objects, but it is short-ranged and consumes an enormous amount of energy.
          - es:
              name: Pistola, máser
              description: Una pistola que dispara un láser de microondas.
        pistol-stutter:
          skill: Mod-pistol
          acc: '0'
          md: F
          range: 6/12/30
          type: LI/O
          damage: d6+2s/d8+2s/d8+4s
          act: '4'
          clip: '10'
          mass: '1.5'
          hide: '+2'
          avail: Com
          cost: '500'
          localized:
          - en:
              name: Pistol, stutter
              description: |-
                This handheld weapon uses sonic energy—audible as a loud, low-frequency rumble—to incapacitate a target. Since the stutter pistol delivers stun damage, it is favored by riot response teams and those who seek to pacify rather than terminate opponents. The stutter pistol doesn't function in a vacuum.
          - es:
              name: Rifle, máser hvy
              description: Un rifle pesado que dispara un láser de microondas.
        rifle-laser:
          skill: Mod-rifle
          acc: '-1'
          md: F
          range: 100/400/1000
          type: En/O
          damage: d6+1w/d6+3w/d4+1m
          act: '3'
          clip: '12'
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '1500'
          localized:
          - en:
              name: Rifle, laser
              description: |-
                The laser rifle is a larger, heavier, improved version of the laser pistol—every bit as accurate as the smaller weapon, and able to hit a target from as far away as a full kilometer.
          - es:
              name: fusil, máser
              description: Un rifle que dispara un láser de microondas.
        rifle-mass:
          skill: Mod-rifle
          acc: '0'
          md: F
          range: 4/12/30
          type: En/G
          damage: d6w/d8+1w/d6+1m
          act: '4'
          clip: '2'
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '2000'
          localized:
          - en:
              name: Rifle, mass
              description: |-
                The mass rifle works on the same principle as the mass pistol, but is heavier and has a longer range.
          - es:
              name: Rifle, mass
              description: |-
                The mass rifle works on the same principle as the mass pistol, but is heavier and has a longer range.
        rifle-quantum:
          skill: Mod-rifle
          acc: '0'
          md: F/B/A
          range: 80/200/500
          type: En/O
          damage: d4+3w/d6+4w/d6+1m
          act: '3'
          clip: 15/5
          mass: '8'
          hide: '-'
          avail: Res
          cost: '8000'
          localized:
          - en:
              name: Rifle, quantum
              description: |-
                This weapon is a personal version of the ship-mounted particle beam. It uses a small accelerator to fire subatomic particles at a target. All personal quantum weapons are extremely expensive and highly restricted, making them rare and often illegal to own and operate.
          - es:
              name: Rifle, quantum
              description: |-
                This weapon is a personal version of the ship-mounted particle beam. It uses a small accelerator to fire subatomic particles at a target. All personal quantum weapons are extremely expensive and highly restricted, making them rare and often illegal to own and operate.
        rifle-render:
          skill: Mod-rifle
          acc: '0'
          md: F
          range: 50/100/250
          type: En/O
          damage: d6+1s/d6+1w/d4+1m
          act: '3'
          clip: '8'
          mass: '4'
          hide: '+1'
          avail: Res
          cost: '2000'
          localized:
          - en:
              name: Rifle, render
              description: |-
                This weapon utilizes gravity induction technology to strobe through a lightning-quick cycle of attraction and repulsion against the target. This action causes matter to literally tear itself to pieces. A lucky target may escape with bad bruises, surface abrasions, and a thorough battering, but a well-centered hit by the render creates massive body trauma.
          - es:
              name: Rifle, render
              description: |-
                This weapon utilizes gravity induction technology to strobe through a lightning-quick cycle of attraction and repulsion against the target. This action causes matter to literally tear itself to pieces. A lucky target may escape with bad bruises, surface abrasions, and a thorough battering, but a well-centered hit by the render creates massive body trauma.
        smg-laser:
          skill: Mod-SMG
          acc: '0'
          md: B/A
          range: 20/80/200
          type: En/O
          damage: d6w/d6+2w/d4m
          act: '4'
          clip: -/10
          mass: '3'
          hide: '-'
          avail: Con
          cost: '1500'
          localized:
          - en:
              name: SMG, laser
              description: |-
                The laser SMG does more damage, has greater accuracy, and fires more shots per clip than previous SMGs.
          - es:
              name: SMG, laser
              description: |-
                The laser SMG does more damage, has greater accuracy, and fires more shots per clip than previous SMGs.
        smg-stutter:
          skill: Mod-SMG
          acc: '0'
          md: B/A
          range: 10/20/80
          type: LI/O
          damage: d6+2s/d8+2s/d8+4s
          act: '4'
          clip: -/20
          mass: '3'
          hide: '+1'
          avail: Con
          cost: '1000'
          localized:
          - en:
              name: SMG, stutter
              description: |-
                The automatic version of the stutter pistol is a favored weapon of riot-control police and others who need to knock out a large number of people without inflicting lethal injuries. The stutter SMG doesn't function in a vacuum.
          - es:
              name: SMG, stutter
              description: |-
                The automatic version of the stutter pistol is a favored weapon of riot-control police and others who need to knock out a large number of people without inflicting lethal injuries. The stutter SMG doesn't function in a vacuum.
        m9-9mm-charge-pistol:
          skill: Ranged-pistol
          acc: '-1'
          md: F
          range: 8/16/60
          type: HI/O
          damage: d4+1w/d6+1w/d4m
          act: '4'
          clip: '15'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '500'
          localized:
          - en:
              name: M9 9mm Charge Pistol
              description: |-
                The M9 charge pistol has been the standard sidearm of the Orion Star Service for more than eighty years. More than two million M9s have been produced by A.M. Industries. It's a good example of a light charge pistol, equipped with a baffled suppressor to hide the weapon's characteristic muzzle flash. In recent years, the Star Service has begun a design competition in search of a replacement for this model. (Payload: 9mm bullet)
          - es:
              name: M9 9mm Charge Pistol
              description: |-
                The M9 charge pistol has been the standard sidearm of the Orion Star Service for more than eighty years. More than two million M9s have been produced by A.M. Industries. It's a good example of a light charge pistol, equipped with a baffled suppressor to hide the weapon's characteristic muzzle flash. In recent years, the Star Service has begun a design competition in search of a replacement for this model. (Payload: 9mm bullet)
        hammer-5-11mm-charge-pistol:
          skill: Ranged-pistol
          acc: '-1'
          md: F
          range: 10/20/80
          type: HI/O
          damage: d4+2w/d6+2w/d4+1m
          act: '3'
          clip: '12'
          mass: '1.2'
          hide: '+2'
          avail: Com
          cost: '1000'
          localized:
          - en:
              name: Hammer 5 11mm Charge Pistol
              description: |-
                One of the finest 11mm pistols on the market, the Soze Hammer 5 is an unusually steady and accurate heavy pistol. It's a little large to fit comfortably in many handgun holsters, but many enthusiasts think that the weapon's legendary accuracy is worth the extra cost and trouble. Numerous models of "standard" 11mm pistols exist, generally priced around $800 for a new gun. (Payload: 11mm bullet)
          - es:
              name: Hammer 5 11mm Charge Pistol
              description: |-
                One of the finest 11mm pistols on the market, the Soze Hammer 5 is an unusually steady and accurate heavy pistol. It's a little large to fit comfortably in many handgun holsters, but many enthusiasts think that the weapon's legendary accuracy is worth the extra cost and trouble. Numerous models of "standard" 11mm pistols exist, generally priced around $800 for a new gun. (Payload: 11mm bullet)
        k-sat-100-9mm-zero-g-pistol:
          skill: Ranged-pistol
          acc: '0'
          md: F
          range: 4/10/40
          type: HI/O
          damage: d4+1w/d6+1w/d4m
          act: '3'
          clip: '15'
          mass: '1'
          hide: '+3'
          avail: Com
          cost: '400'
          localized:
          - en:
              name: K-SAT 100 9mm Zero-G Pistol
              description: |-
                The Karadnya is a vintage design that's been around for more than fifty years. A muzzle brake and recoil cylinder surrounding the weapon's action make it virtually recoil-free. Although its low muzzle velocity limits its range, the K-SAT reduces any penalties for firing in zero-g conditions by 1 step. Today, energy weapons such as the laser pistol are beginning to replace the old zero-g firearms. (Payload: 9mm bullet)
          - es:
              name: K-SAT 100 9mm Zero-G Pistol
              description: |-
                The Karadnya is a vintage design that's been around for more than fifty years. A muzzle brake and recoil cylinder surrounding the weapon's action make it virtually recoil-free. Although its low muzzle velocity limits its range, the K-SAT reduces any penalties for firing in zero-g conditions by 1 step. Today, energy weapons such as the laser pistol are beginning to replace the old zero-g firearms. (Payload: 9mm bullet)
        arz-6mm-charge-autorifle:
          skill: Ranged-rifle
          acc: '-1'
          md: B/A
          range: 60/150/400
          type: HI/O
          damage: d6w/2d4w/d4+1m
          act: '3'
          clip: 30 bursts
          mass: '2.75'
          hide: '-'
          avail: Mil
          cost: '2000'
          localized:
          - en:
              name: ARZ 6mm Charge Autorifle
              description: |-
                Autorifles are light weapons with a very high rate of fire, intended for assault or support roles. The ARZ is one of the most popular of these designs; originally produced by Karadnya-Brusilev of Nariac, it's now manufactured under license in the Thuldan Empire and the Solar Union. The model shown here is fitted with the standard 100-round magazine, which provides the soldier with plenty of ammo. (Payload: 6mm bullet)
          - es:
              name: ARZ 6mm Charge Autorifle
              description: |-
                Autorifles are light weapons with a very high rate of fire, intended for assault or support roles. The ARZ is one of the most popular of these designs; originally produced by Karadnya-Brusilev of Nariac, it's now manufactured under license in the Thuldan Empire and the Solar Union. The model shown here is fitted with the standard 100-round magazine, which provides the soldier with plenty of ammo. (Payload: 6mm bullet)
        if-3-11mm-charge-rifle:
          skill: Ranged-rifle
          acc: '0'
          md: F/B/A
          range: 90/180/600
          type: HI/O
          damage: d6+1w/d6+3w/d6+1m
          act: '4'
          clip: 30 rounds/10 bursts
          mass: '3'
          hide: '-'
          avail: Mil
          cost: '1600'
          localized:
          - en:
              name: IF-3 11mm Charge Rifle
              description: |-
                IF-3 has been the standard infantry weapon of the Concord Defense Corps and the Concord Marines. Adopted from Austrin-Ontis as the best combat rifle available at the time, the IF-3 is light, rugged, and long-ranged. With the addition of a $50 conversion kit, the IF-3 can be configured for zero-g combat. This halves all range figures, but reduces zero-g penalties by 1 step. (Payload: 11mm bullet)
          - es:
              name: IF-3 11mm Charge Rifle
              description: |-
                IF-3 has been the standard infantry weapon of the Concord Defense Corps and the Concord Marines. Adopted from Austrin-Ontis as the best combat rifle available at the time, the IF-3 is light, rugged, and long-ranged. With the addition of a $50 conversion kit, the IF-3 can be configured for zero-g combat. This halves all range figures, but reduces zero-g penalties by 1 step. (Payload: 11mm bullet)
        bulldog-9mm-charge-smg:
          skill: Ranged-SMG
          acc: '0'
          md: B/A
          range: 20/50/100
          type: HI/O
          damage: d4+1w/d6+1w/d4m
          act: '4'
          clip: 8 bursts
          mass: '2.25'
          hide: '+1'
          avail: Mil
          cost: '1750'
          localized:
          - en:
              name: Bulldog 9mm Charge SMG
              description: |-
                The Bulldog is a fine example of a second-generation weapon. Many of the flaws of earlier charge SMGs were corrected in this design. It's compact and sturdy, standing up to the worst field conditions. The most innovative feature is a recoil suppression system that controls the natural tendency of an automatic weapon to "walk" when fired in full auto-the Bulldog's accuracy is legendary. (Payload: 9mm bullet)
          - es:
              name: Bulldog 9mm Charge SMG
              description: |-
                The Bulldog is a fine example of a second-generation weapon. Many of the flaws of earlier charge SMGs were corrected in this design. It's compact and sturdy, standing up to the worst field conditions. The most innovative feature is a recoil suppression system that controls the natural tendency of an automatic weapon to "walk" when fired in full auto-the Bulldog's accuracy is legendary. (Payload: 9mm bullet)
        agc-7-autoflechette-shotgun:
          skill: Ranged-rifle
          acc: '0'
          md: F/B/A
          range: 10/20/50
          type: HI/O
          damage: d4w/d6w/d4m
          act: '4'
          clip: 15 rounds/5 bursts
          mass: '3.25'
          hide: '+1'
          avail: Mil
          cost: '2750'
          localized:
          - en:
              name: AGC-7 Autoflechette Shotgun
              description: |-
                The AGC-7 (or "Aggie," as it's affectionately known) is one of the most fearsome close assault weapons in existence. It's a fully automatic charge weapon firing 20mm flechette rounds-bundles of razor-sharp needles that shred anything they hit. Like other shotguns, it inflicts double damage to targets within short range (10 meters), and only half damage (minimum of 1 point) to targets at long range. (Payload: 25mm flechette round)
          - es:
              name: AGC-7 Autoflechette Shotgun
              description: |-
                The AGC-7 (or "Aggie," as it's affectionately known) is one of the most fearsome close assault weapons in existence. It's a fully automatic charge weapon firing 20mm flechette rounds-bundles of razor-sharp needles that shred anything they hit. Like other shotguns, it inflicts double damage to targets within short range (10 meters), and only half damage (minimum of 1 point) to targets at long range. (Payload: 25mm flechette round)
        devastator-flechette-pistol:
          skill: Ranged-pistol
          acc: '-1'
          md: F
          range: 8/16/40
          type: HI/O
          damage: d4w/d6w/d4m
          act: '3'
          clip: '6'
          mass: '1.5'
          hide: '+2'
          avail: Mil
          cost: '1450'
          localized:
          - en:
              name: Devastator Flechette Pistol
              description: |-
                The Devastator is a succinct statement of the Soze Arms design philosophy-overkill is the way to go. This pistol fires a wide-pattern flechette round, shredding anything in the general vicinity. It inflicts double the listed damage at close range (8 meters or less), but only half damage for shots at long range (16 to 40 meters). The flechette pistol doesn't have the full-auto capability of the autoflechette shotgun. (Payload: 25mm flechette round)
          - es:
              name: Devastator Flechette Pistol
              description: |-
                The Devastator is a succinct statement of the Soze Arms design philosophy-overkill is the way to go. This pistol fires a wide-pattern flechette round, shredding anything in the general vicinity. It inflicts double the listed damage at close range (8 meters or less), but only half damage for shots at long range (16 to 40 meters). The flechette pistol doesn't have the full-auto capability of the autoflechette shotgun. (Payload: 25mm flechette round)
        tornado-600-15mm-sabot-pistol:
          skill: Ranged-pistol
          acc: '0'
          md: F
          range: 10/20/100
          type: HI/O
          damage: 2d4w/2d4+1w/d4+3m
          act: '3'
          clip: '6'
          mass: '2'
          hide: '+1'
          avail: Con
          cost: '900'
          localized:
          - en:
              name: Tornado 600 15mm Sabot Pistol
              description: |-
                Sabot pistols are big and heavy, but they're the most powerful handguns produced in any numbers. The weapon has great range for a pistol, and almost no kick-the accelerator pushes the slug out of the barrel with a smooth, nonexplosive action. The sabot pistol's lanthanide cell provides enough energy to fire four clips of ammo before it's exhausted; the cell can be recharged for $10 or replaced for $200. (Payload: 10mm sabot ramjet)
          - es:
              name: Tornado 600 15mm Sabot Pistol
              description: |-
                Sabot pistols are big and heavy, but they're the most powerful handguns produced in any numbers. The weapon has great range for a pistol, and almost no kick-the accelerator pushes the slug out of the barrel with a smooth, nonexplosive action. The sabot pistol's lanthanide cell provides enough energy to fire four clips of ammo before it's exhausted; the cell can be recharged for $10 or replaced for $200. (Payload: 10mm sabot ramjet)
        ms-15mm-sabot-rifle:
          skill: Ranged-rifle
          acc: '0'
          md: F
          range: 80/200/800
          type: HI/O
          damage: d4+4w/2d4+2w/d6+3m
          act: '2'
          clip: '12'
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '4500'
          localized:
          - en:
              name: MS 15mm Sabot Rifle
              description: |-
                While no one questions the sabot rifle's range or hitting power, its lack of automatic-fire capability has limited its appeal. Other combat rifles of the day provide a greater volume of fire, longer range, or better armor penetration. Despite this, the sabot rifle is popular with scouts and colonial militias who want one-shot stopping power at range for dealing with dangerous native creatures. (Payload: 10mm sabot ramjet)
          - es:
              name: MS 15mm Sabot Rifle
              description: |-
                While no one questions the sabot rifle's range or hitting power, its lack of automatic-fire capability has limited its appeal. Other combat rifles of the day provide a greater volume of fire, longer range, or better armor penetration. Despite this, the sabot rifle is popular with scouts and colonial militias who want one-shot stopping power at range for dealing with dangerous native creatures. (Payload: 10mm sabot ramjet)
        nova-6-mass-pistol:
          skill: Ranged-pistol
          acc: '0'
          md: F
          range: 2/6/12
          type: En/G
          damage: d6w/d6+2w/d6m
          act: '3'
          clip: '6'
          mass: '1'
          hide: '+2'
          avail: Mil
          cost: '1475'
          localized:
          - en:
              name: Nova 6 Mass Pistol
              description: |-
                Made famous by the action holomovies of Jack Everstar, the Nova 6 is a top-of-the-line mass pistol. Slightly more efficient than most mass pistols, the charge cells of a Nova 6 can power up to six shots before exhausting the weapon's energy reserves. Mass pistols are virtually useless in open terrain, but there aren't many weapons better for close-quarters combat against armored foes. (Payload: Gravity point-source)
          - es:
              name: Nova 6 Mass Pistol
              description: |-
                Made famous by the action holomovies of Jack Everstar, the Nova 6 is a top-of-the-line mass pistol. Slightly more efficient than most mass pistols, the charge cells of a Nova 6 can power up to six shots before exhausting the weapon's energy reserves. Mass pistols are virtually useless in open terrain, but there aren't many weapons better for close-quarters combat against armored foes. (Payload: Gravity point-source)
        aamg-12-mass-rifle:
          skill: Ranged-rifle
          acc: '-1'
          md: F
          range: 4/12/30
          type: En/G
          damage: d6+1w/d8+1w/d6+1m
          act: '2'
          clip: 8 shots
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '2450'
          localized:
          - en:
              name: AAMG-12 Mass Rifle
              description: |-
                A larger and more powerful version of the mass pistol, the mass rifle sacrifices range and rate of fire for unbeatable armor penetration. The AAMG is a brand-new design from Karadnya-Brusilev. It's the most accurate mass rifle on the market today, and its new charge cell technology doubles its magazine capacity compared to others of its type. (Payload: Gravity point-source)
          - es:
              name: AAMG-12 Mass Rifle
              description: |-
                A larger and more powerful version of the mass pistol, the mass rifle sacrifices range and rate of fire for unbeatable armor penetration. The AAMG is a brand-new design from Karadnya-Brusilev. It's the most accurate mass rifle on the market today, and its new charge cell technology doubles its magazine capacity compared to others of its type. (Payload: Gravity point-source)
        ninja-600-laser-pistol:
          skill: Ranged-pistol
          acc: '-1'
          md: F
          range: 20/40/150
          type: En/O
          damage: d4+1w/d6+1w/d4m
          act: '4'
          clip: 20 shots
          mass: '0.5'
          hide: '+4'
          avail: Con
          cost: '1225'
          localized:
          - en:
              name: Ninja 600 Laser Pistol
              description: |-
                The Ninja 600 is a small and easily concealable laser pistol built to the flush-front design. Like all lasers, it's extremely accurate and offers the best range characteristics of any handgun. The Ninja line is very popular with corporate execs and other affluent celebrities who want to carry a weapon for self-defense without advertising the fact that they're armed. Most combat specs prefer a heavier weapon. (Payload: Coherent light)
          - es:
              name: Ninja 600 Laser Pistol
              description: |-
                The Ninja 600 is a small and easily concealable laser pistol built to the flush-front design. Like all lasers, it's extremely accurate and offers the best range characteristics of any handgun. The Ninja line is very popular with corporate execs and other affluent celebrities who want to carry a weapon for self-defense without advertising the fact that they're armed. Most combat specs prefer a heavier weapon. (Payload: Coherent light)
        clr-19-laser-rifle:
          skill: Ranged-rifle
          acc: '-1'
          md: F
          range: 100/600/1500
          type: En/O
          damage: d6+1w/d6+3w/d4+1m
          act: '3'
          clip: 12 shots
          mass: '4'
          hide: '-'
          avail: Mil
          cost: '1800'
          localized:
          - en:
              name: CLR-19 Laser Rifle
              description: |-
                The standard infantry firearm of the Orion League, CLR-19 (Combat Laser Rifle-19) is a weapon of extraordinary range and accuracy. It's proven its value in numerous engagements against older charge weapons, especially in relatively open terrain. In close quarters, the weapon's length and low rate of fire are distinct drawbacks compared to the faster-firing and harder-hitting 11mm charge rifle. (Payload: Coherent light)
          - es:
              name: CLR-19 Laser Rifle
              description: |-
                The standard infantry firearm of the Orion League, CLR-19 (Combat Laser Rifle-19) is a weapon of extraordinary range and accuracy. It's proven its value in numerous engagements against older charge weapons, especially in relatively open terrain. In close quarters, the weapon's length and low rate of fire are distinct drawbacks compared to the faster-firing and harder-hitting 11mm charge rifle. (Payload: Coherent light)
        valkyrie-9-autolaser:
          skill: Ranged-SMG
          acc: '0'
          md: B/A
          range: 20/80/200
          type: En/O
          damage: d6+1w/d6+3w/d4+1m
          act: '4'
          clip: 10 bursts
          mass: '3.25'
          hide: '-'
          avail: Con
          cost: '1725'
          localized:
          - en:
              name: Valkyrie 9 Autolaser
              description: |-
                The largest and most powerful autolaser available, the Valkyrie offers damage equal to a laser rifle with full automatic fire. While many people refer to the autolaser as a laser submachine gun, this is a misnomer-the device is not a machine gun and has little in common with any conventional firearm. Bursts or full-auto attacks with this weapon are actually sweeps and slashes of its white-hot beam. (Payload: Coherent light)
          - es:
              name: Valkyrie 9 Autolaser
              description: |-
                The largest and most powerful autolaser available, the Valkyrie offers damage equal to a laser rifle with full automatic fire. While many people refer to the autolaser as a laser submachine gun, this is a misnomer-the device is not a machine gun and has little in common with any conventional firearm. Bursts or full-auto attacks with this weapon are actually sweeps and slashes of its white-hot beam. (Payload: Coherent light)
        falcon-t9-stutter-pistol:
          skill: Ranged-pistol
          acc: '0'
          md: F
          range: 4/8/20
          type: LI/O
          damage: d6+2s/d8+2s/d8+4s
          act: '3'
          clip: 10 shots
          mass: '0.75'
          hide: '+4'
          avail: Com
          cost: '375'
          localized:
          - en:
              name: Falcon T9 Stutter Pistol
              description: |-
                One of the most popular handguns in human space, the Falcon T9 is synonymous with reasonably priced, nonlethal personal defense. It's lighter and slimmer than the standard stutter pistol, trading range and clip capacity for easy concealment and use by people who aren't highly trained. 'Point and say good-night' is the tag line for SekureTek's Falcon ads, and it's just about that easy. (Payload: Compressed air)
          - es:
              name: Falcon T9 Stutter Pistol
              description: |-
                One of the most popular handguns in human space, the Falcon T9 is synonymous with reasonably priced, nonlethal personal defense. It's lighter and slimmer than the standard stutter pistol, trading range and clip capacity for easy concealment and use by people who aren't highly trained. 'Point and say good-night' is the tag line for SekureTek's Falcon ads, and it's just about that easy. (Payload: Compressed air)
        condor-x7-stutter-pistol:
          skill: Ranged-pistol
          acc: '0'
          md: F
          range: 8/16/40
          type: LI/O
          damage: d6+3s/d8+3s/d12+3s
          act: '3'
          clip: 8 shots
          mass: '1.25'
          hide: '+1'
          avail: Com
          cost: '850'
          localized:
          - en:
              name: Condor X7 Stutter Pistol
              description: |-
                Professional peacekeepers prefer a more capable weapon than the light stutter pistols favored for personal defense. The Condor is an example of the heavy stutter pistol, a weapon designed for the subdual of armed, dangerous criminals. One hit almost always dazes or knocks out an unarmored opponent, and even armored targets can be brought down with accurate and sustained fire. (Payload: Compressed air)
          - es:
              name: Condor X7 Stutter Pistol
              description: |-
                Professional peacekeepers prefer a more capable weapon than the light stutter pistols favored for personal defense. The Condor is an example of the heavy stutter pistol, a weapon designed for the subdual of armed, dangerous criminals. One hit almost always dazes or knocks out an unarmored opponent, and even armored targets can be brought down with accurate and sustained fire. (Payload: Compressed air)
        cyclone-700-stutter-smg:
          skill: Ranged-SMG
          acc: '0'
          md: B/A
          range: 10/20/80
          type: LI/O
          damage: d6+2s/d8+2s/d8+4s
          act: '4'
          clip: 20 bursts
          mass: '3'
          hide: '+1'
          avail: Con
          cost: '1000'
          localized:
          - en:
              name: Cyclone 700 Stutter SMG
              description: |-
                The stutter SMG isn't a real submachine gun, of course; it's referred to as an SMG because of its high cyclic rate of fire. It's intended for use in close-quarters riot control or police raid situations in which the authorities must subdue a large number of people in a very short time. Stutter SMGs are also favored by special forces teams attempting to take prisoners instead of simply killing their enemies. (Payload: Compressed air)
          - es:
              name: Cyclone 700 Stutter SMG
              description: |-
                The stutter SMG isn't a real submachine gun, of course; it's referred to as an SMG because of its high cyclic rate of fire. It's intended for use in close-quarters riot control or police raid situations in which the authorities must subdue a large number of people in a very short time. Stutter SMGs are also favored by special forces teams attempting to take prisoners instead of simply killing their enemies. (Payload: Compressed air)
        sirocco-100-stutter-rifle:
          skill: Ranged-rifle
          acc: '-1'
          md: F
          range: 20/40/200
          type: LI/O
          damage: d6+3s/d8+3s/d12+3s
          act: '2'
          clip: 12 shots
          mass: '3.5'
          hide: '-'
          avail: Con
          cost: '750'
          localized:
          - en:
              name: Sirocco 100 Stutter Rifle
              description: |-
                In situations where you're only going to get one chance to stun an opponent, the stutter rifle's a good choice. It offers a longer range, more hitting power, and better accuracy than any other stutter weapon, making it perfect for taking out a problem with one clean shot at distance. The Sirocco is renowned as a scout's weapon, durable and effective; last year it won Merrick's Triple-Bullseye for best in class. (Payload: Compressed air)
          - es:
              name: Sirocco 100 Stutter Rifle
              description: |-
                In situations where you're only going to get one chance to stun an opponent, the stutter rifle's a good choice. It offers a longer range, more hitting power, and better accuracy than any other stutter weapon, making it perfect for taking out a problem with one clean shot at distance. The Sirocco is renowned as a scout's weapon, durable and effective; last year it won Merrick's Triple-Bullseye for best in class. (Payload: Compressed air)
        tauri-9-impact-pistol:
          skill: Ranged-pistol
          acc: '0'
          md: F/B
          range: 4/12/36
          type: LI/O
          damage: 2d4s/d6+1w/d6+3w
          act: '4'
          clip: 12 shots/4 bursts
          mass: '1'
          hide: '+2'
          avail: Con
          cost: '1150'
          localized:
          - en:
              name: Tauri 9 Impact Pistol
              description: |-
                A deadly refinement of stutter weapon technology, the impact pistol fires an even more powerful blast of compressed air that can powder concrete at close range. It can be set for a high-speed mode that allows burst fire (but not full automatic), or for low-speed, single-shot mode. Like any stutter weapon, the impact pistol doesn't work in vacuum due to the lack of air to compress. (Payload: Compressed air)
          - es:
              name: Tauri 9 Impact Pistol
              description: |-
                A deadly refinement of stutter weapon technology, the impact pistol fires an even more powerful blast of compressed air that can powder concrete at close range. It can be set for a high-speed mode that allows burst fire (but not full automatic), or for low-speed, single-shot mode. Like any stutter weapon, the impact pistol doesn't work in vacuum due to the lack of air to compress. (Payload: Compressed air)
        apache-lx-reflex-bow:
          skill: Ranged-bow
          acc: '0'
          md: F
          range: 50/100/250
          type: LI/O
          damage: d4+2w/d6+2w/d4+1m
          act: '2'
          clip: 1 shot
          mass: '1'
          hide: '-'
          avail: Com
          cost: '650'
          localized:
          - en:
              name: Apache LX Reflex Bow
              description: |-
                The bow's greatest advantage is silence and stealth. It has no muzzle flash or loud report to give away the user's location, making it perfect for dense terrain such as jungle or heavy brush. Its disadvantage is the low rate of fire (after each 'shot', the user must waste an action to ready another arrow, or shoot with a +2 step penalty) and its size, which prevents it from being fired from a prone position. (Payload: Razor-tipped arrow)
          - es:
              name: Apache LX Reflex Bow
              description: |-
                The bow's greatest advantage is silence and stealth. It has no muzzle flash or loud report to give away the user's location, making it perfect for dense terrain such as jungle or heavy brush. Its disadvantage is the low rate of fire (after each 'shot', the user must waste an action to ready another arrow, or shoot with a +2 step penalty) and its size, which prevents it from being fired from a prone position. (Payload: Razor-tipped arrow)
        commando-3000-crossbow:
          skill: Ranged-bow
          acc: '0'
          md: F
          range: 60/120/300
          type: HI/O
          damage: d6+1w/d8+1w/d6m
          act: '2'
          clip: 1 shot
          mass: '2'
          hide: '-'
          avail: Con
          cost: '950'
          localized:
          - en:
              name: Commando 3000 Crossbow
              description: |-
                Modern crossbows are extremely dangerous weapons, with hitting power comparable to a high-powered rifle. Like the bow, it's silent and dark, perfect for stealthy missions. On the downside, it's slow; after each shot, the marksman must spend an action to cock the weapon and ready another quarrel. However, crossbows can be carried cocked and can be fired from a prone position. (Payload: Razor-tipped bolt)
          - es:
              name: Commando 3000 Crossbow
              description: |-
                Modern crossbows are extremely dangerous weapons, with hitting power comparable to a high-powered rifle. Like the bow, it's silent and dark, perfect for stealthy missions. On the downside, it's slow; after each shot, the marksman must spend an action to cock the weapon and ready another quarrel. However, crossbows can be carried cocked and can be fired from a prone position. (Payload: Razor-tipped bolt)
        cobra-f77-dart-gun:
          skill: Ranged-pistol
          acc: '0'
          md: F
          range: 4/8/16
          type: LI/O
          damage: d4-1w/d4w/d4+1w
          act: '2'
          clip: 6 shots
          mass: '1.5'
          hide: '+2'
          avail: Com
          cost: '450'
          localized:
          - en:
              name: Cobra F77 Dart Gun
              description: |-
                The dart gun is a pneumatic pistol designed to fire a large, hollow dart. One popular version of this gun (pictured) is a specially designed, pocket-sized weapon (Hide value +4, cost $300). While the dart can inflict serious injury by itself, it's usually used as a delivery system for an insinuative venom. The typical dart is filled with neurotoxin (+1 step penalty to the victim's Constitution feat check, onset time d4 rounds) or a paralytic agent (+2 step penalty, onset time d4-1 rounds). (Payload: Poison-tipped dart)
          - es:
              name: Cobra F77 Dart Gun
              description: |-
                The dart gun is a pneumatic pistol designed to fire a large, hollow dart. One popular version of this gun (pictured) is a specially designed, pocket-sized weapon (Hide value +4, cost $300). While the dart can inflict serious injury by itself, it's usually used as a delivery system for an insinuative venom. The typical dart is filled with neurotoxin (+1 step penalty to the victim's Constitution feat check, onset time d4 rounds) or a paralytic agent (+2 step penalty, onset time d4-1 rounds). (Payload: Poison-tipped dart)
        blue-bolt-arc-gun:
          skill: Ranged-rifle
          acc: '-1'
          md: F
          range: 20/40/100
          type: En/G
          damage: d8+1s/d8w/d6+3w
          act: '2'
          clip: 12 shots
          mass: '10'
          hide: '-'
          avail: Mil
          cost: '2750'
          localized:
          - en:
              name: Blue Bolt Arc Gun
              description: |-
                Designed for close assault, both arc guns and flamers are accurate weapons at short ranges. The Blue Bolt has an unusual feature not found on many arc guns-a wireless taser setting. When it's activated, the gun's laser marker measures the target's surface resistance and calculates an appropriate stun charge. In taser mode, the Blue Bolt inflicts d8+1s/2d6s/2d6+2s for an Ordinary, Good, or Amazing success on the attack skill check. Switching from taser mode to normal operation requires an action. (Payload: Electrical arc)
          - es:
              name: Blue Bolt Arc Gun
              description: |-
                Designed for close assault, both arc guns and flamers are accurate weapons at short ranges. The Blue Bolt has an unusual feature not found on many arc guns-a wireless taser setting. When it's activated, the gun's laser marker measures the target's surface resistance and calculates an appropriate stun charge. In taser mode, the Blue Bolt inflicts d8+1s/2d6s/2d6+2s for an Ordinary, Good, or Amazing success on the attack skill check. Switching from taser mode to normal operation requires an action. (Payload: Electrical arc)
        demon-9-hand-flamer:
          skill: Ranged-SMG
          acc: '-1'
          md: F/B/A
          range: 6/12/24
          type: En/O
          damage: d6w/d6+2w/d8+3w
          act: '3'
          clip: 10 shots/3 bursts
          mass: '4.5'
          hide: '-1'
          avail: Con
          cost: '1200'
          localized:
          - en:
              name: Demon 9 Hand Flamer
              description: |-
                The Gravity Age successors to the venerable flamethrower, flamers are vicious weapons that spew a tight aerosol spray of self-oxidizing fuel gel at the target. Its broad pattern ensures great accuracy at close range, and the flame spray inflicts terrible wounds. By holding down the trigger and fanning the weapon from side to side, the user can achieve an autofirelike effect, but this rapidly exhausts his fuel. (Payload: Incendiary stream)
          - es:
              name: Demon 9 Hand Flamer
              description: |-
                The Gravity Age successors to the venerable flamethrower, flamers are vicious weapons that spew a tight aerosol spray of self-oxidizing fuel gel at the target. Its broad pattern ensures great accuracy at close range, and the flame spray inflicts terrible wounds. By holding down the trigger and fanning the weapon from side to side, the user can achieve an autofirelike effect, but this rapidly exhausts his fuel. (Payload: Incendiary stream)
        z-lok-render-rifle:
          skill: Ranged-rifle
          acc: '0'
          md: F
          range: 50/100/250
          type: En/O
          damage: d6+1s/d6+1w/d4+1m
          act: '3'
          clip: 8 shots
          mass: '4'
          hide: '-'
          avail: Res
          cost: '2000'
          localized:
          - en:
              name: Z-LOK Render Rifle
              description: |-
                The Z-LOK render rifle projects a graviton beam that creates destructive tidal attractions within the target's structure. While it's not particularly lethal compared to other Gravity Age rifles, it offers one big advantage-the target's armor is reduced to its minimal protection value against the beam. For example, cerametal armor normally stops d6 points of energy damage, but against a render rifle it only stops 1 point, the minimum possible (no roll allowed). (Payload: Graviton beam)
          - es:
              name: Z-LOK Render Rifle
              description: |-
                The Z-LOK render rifle projects a graviton beam that creates destructive tidal attractions within the target's structure. While it's not particularly lethal compared to other Gravity Age rifles, it offers one big advantage-the target's armor is reduced to its minimal protection value against the beam. For example, cerametal armor normally stops d6 points of energy damage, but against a render rifle it only stops 1 point, the minimum possible (no roll allowed). (Payload: Graviton beam)
        bloodhound-f3-smart-grenade:
          skill: Athletics-throw
          acc: '-1'
          md: F
          range: per STR or 30/60/120
          type: by warhead
          damage: by warhead
          act: '2'
          clip: n/a
          mass: '0.5'
          hide: '+3'
          avail: Mil
          cost: '300'
          localized:
          - en:
              name: Bloodhound F3 Smart Grenade
              description: |-
                The Bloodhound smart grenade is a delivery system attached to any other grenade warhead. The thrower can spend an action to lock its image targeting system onto a target. When he throws the grenade in a subsequent action, its rocket motor guides it to the target. In guided flight, the grenade has a range of 30/60/120 meters and an accuracy of -1; in unguided mode, it's treated like any other thrown grenade. (Payload: Various grenades)
          - es:
              name: Bloodhound F3 Smart Grenade
              description: |-
                The Bloodhound smart grenade is a delivery system attached to any other grenade warhead. The thrower can spend an action to lock its image targeting system onto a target. When he throws the grenade in a subsequent action, its rocket motor guides it to the target. In guided flight, the grenade has a range of 30/60/120 meters and an accuracy of -1; in unguided mode, it's treated like any other thrown grenade. (Payload: Various grenades)
    pl-8-energy-age:
      localized:
      - en:
          name: 'PL 8: Energy Age'
      - es:
          name: 'PL 8: Energy Age'
      items:
        automaser:
          skill: Mod-SMG
          acc: '-1'
          md: B/A
          range: 20/60/120
          type: En/O
          damage: d6w/d6+2w/d4m
          act: '4'
          clip: -/20
          mass: '3'
          hide: '-'
          avail: Mil
          cost: '20000'
          localized:
          - en:
              name: Automaser
              description: |-
                This submachine gun is a heavy maser pistol (see below) capable of full automatic fire. It uses a small mass reactor and an internal antenna array to create a broadband blast of electromagnetic energy, combining the nastier features of a laser and a microwave beam.
          - es:
              name: Automaser
              description: |-
                This submachine gun is a heavy maser pistol (see below) capable of full automatic fire. It uses a small mass reactor and an internal antenna array to create a broadband blast of electromagnetic energy, combining the nastier features of a laser and a microwave beam.
        pistol-hvy-maser:
          skill: Mod-pistol
          acc: '-1'
          md: F
          range: 20/40/80
          type: En/G
          damage: d6+1w/2d4+1w/d4+1m
          act: '3'
          clip: '30'
          mass: '2'
          hide: '+1'
          avail: Mil
          cost: '12000'
          localized:
          - en:
              name: Pistol, hvy maser
              description: |-
                The heavy maser pistol harnesses the power of a miniature mass reactor to create destructive bolts of broadband electromagnetic radiation. This results in a beam with the cutting or penetrating power of a high-grade laser, coupled with the scorching and charring of a microwave burst.
          - es:
              name: Pistol, hvy maser
              description: |-
                The heavy maser pistol harnesses the power of a miniature mass reactor to create destructive bolts of broadband electromagnetic radiation. This results in a beam with the cutting or penetrating power of a high-grade laser, coupled with the scorching and charring of a microwave burst.
        pistol-maser:
          skill: Mod-pistol
          acc: '-2'
          md: F
          range: 10/20/60
          type: En/O
          damage: d6w/d6+2w/d4m
          act: '4'
          clip: '40'
          mass: '1'
          hide: '+2'
          avail: Con
          cost: '8000'
          localized:
          - en:
              name: Pistol, maser
              description: |-
                The maser pistol—one of the most accurate weapons ever produced—is a less powerful version of the heavy maser pistol.
          - es:
              name: Pistol, maser
              description: |-
                The maser pistol—one of the most accurate weapons ever produced—is a less powerful version of the heavy maser pistol.
        rifle-hvy-maser:
          skill: Mod-rifle
          acc: '-1'
          md: F/B/A
          range: 40/200/500
          type: En/G
          damage: d8+1w/d12w/d6+1m
          act: '3'
          clip: 60/20
          mass: '5'
          hide: '-'
