                Communication using expensive drivesats to relay message capsules across light-years; subject to 11-hour delays.
          - es:
              name: Comm call, interstellar
              description: |-
                Communication using expensive drivesats to relay message capsules across light-years; subject to 11-hour delays.
        lawyer:
          pl: '4'
          mass: '-'
          cost: 300/hour
          localized:
          - en:
              name: Lawyer
              description: |-
                Legal representation for criminal or civil matters. Famous lawyers charge significantly more.
          - es:
              name: Lawyer
              description: |-
                Legal representation for criminal or civil matters. Famous lawyers charge significantly more.
        medical-surgery:
          pl: '4'
          mass: '-'
          cost: '5000'
          localized:
          - en:
              name: Medical, surgery
              description: |-
                Professional intervention for mortal damage. State-of-the-art facilities provide a -3 bonus to skill checks.
          - es:
              name: Medical, surgery
              description: |-
                Professional intervention for mortal damage. State-of-the-art facilities provide a -3 bonus to skill checks.
