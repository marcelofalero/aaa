        - name: Descripción
          key: description
          hidden: true
  items:
    survival-and-miscellaneous-gear:
      localized:
      - en:
          name: Survival and Miscellaneous Gear
      - es:
          name: Equipo general
      items:
        bedroll:
          pl: '2'
          mass: '4'
          cost: '25'
          localized:
          - en:
              name: Bedroll
              description: |-
                Range from simple blankets to inflatable, battery-warmed beds depending on Progress Level.
          - es:
              name: animal, guardia
              description: ''
        boots-magnetic:
          pl: '6'
          mass: '4'
          cost: '350'
          localized:
          - en:
              name: Boots, magnetic
              description: |-
                Allows walking on magnetic surfaces in zero gravity. Magnets can hold a mass of 200 kg. Battery lasts 24 hours.
          - es:
              name: animal, montura
              description: ''
        cabin-portable:
          pl: '7'
          mass: '40'
          cost: '650'
          localized:
          - en:
              name: Cabin, portable
              description: |-
                Backpack-sized unit that deploys into a 4m x 3m cabin. Includes camping unit and bedrolls. Not airtight.
          - es:
              name: animal, manada
              description: ''
        camping-unit:
          pl: '6'
          mass: '10'
          cost: '300'
          localized:
          - en:
              name: Camping unit
              description: |-
                Combines a portable stove, heater, air conditioner, and refrigerator. Power lasts 2 weeks.
          - es:
              name: animal, mascota
              description: ''
        candle:
          pl: '1'
          mass: '1'
          cost: '-'
          localized:
          - en:
              name: Candle
              description: |2-
                 combustible cylinder providing light in a 2-3 meter radius. High PL versions burn for 1-2 days.
          - es:
              name: petate
              description: ''
        climate-weave:
          pl: '7'
          mass: '-'
          cost: Cost x 2
          localized:
          - en:
              name: Climate weave
              description: |-
                Fabric containing passive heating and cooling elements. Keeps wearer comfortable from -40°C to 60°C without power.
          - es:
              name: biobloqueo
              description: |-
                Una cerradura que utiliza autenticación biométrica (por ejemplo, huella digital, escaneo de retina) por seguridad.
        climbing-gear:
          pl: '4'
          mass: '10'
          cost: '100'
          localized:
          - en:
              name: Climbing gear
              description: |-
                Includes 50m rope, piton hammer, 20 pitons, rappelling belt, and ax. Provides a -3 bonus to climbing checks.
          - es:
              name: Botas magnéticas
              description: |-
                Botas equipadas con suela magnética para caminar sobre superficies metálicas en entornos de gravedad cero o invertidos.
        cooler:
          pl: '4'
          mass: '5'
          cost: '50'
          localized:
          - en:
              name: Cooler
              description: |-
                Portable refrigerant unit for medical supplies or perishables. Battery lasts 48 hours.
          - es:
              name: Cabina, portátil
              description: ''
        emergency-beacon:
          pl: '5'
          mass: '10'
          cost: '200'
          localized:
          - en:
              name: Emergency beacon
              description: |-
                Transmitter that broadcasts a homing signal detectable from orbit. Battery lasts 3 months.
          - es:
              name: Unidad de campamento
              description: ''
        e-suit-soft:
          pl: '5'
          mass: '10'
          cost: '2500'
          localized:
          - en:
              name: E-suit, soft
              description: |-
                Bulky suit with life-support for spacers. Protects in H3 heat and P4 pressure. Armor equivalent to a battle vest.
          - es:
              name: Vela
              description: ''
        e-suit-hard:
          pl: '6'
          mass: '20'
          cost: '4000'
          localized:
          - en:
              name: E-suit, hard
              description: |-
                Environment suit with polymere plates for H4 heat and P4 pressure. Armor equivalent to heavy assault gear.
          - es:
              name: Tejido climático
              description: |-
                Tejido tejido con microfilamentos que pueden regular activamente la temperatura, brindando protección contra el calor o el frío extremos.
        flashlight:
          pl: '4'
          mass: '1'
          cost: '25'
          localized:
          - en:
              name: Flashlight
              description: |-
                Battery-powered light. PL 5+ models include pinpoint beams or ultraviolet rays. Battery lasts 1 week.
          - es:
              name: Equipo de escalada
              description: ''
        habitat-dome:
          pl: '6'
          mass: '50'
          cost: '1500'
          localized:
          - en:
              name: Habitat dome
              description: |-
                Airtight, insulated 4m dome for sparse atmospheres. Includes beacon, rations, and water purifier.
          - es:
              name: Enfriador
              description: ''
        jumpsuit:
          pl: '6'
          mass: '3'
          cost: '750'
          localized:
          - en:
              name: Jumpsuit
              description: |-
                Shipboard coverall with vacuum mask and seals. Protects against decompression for 1 hour in open space.
          - es:
              name: cinta adhesiva
              description: ''
        animal-guard:
          pl: '1'
          mass: varies
          cost: varies
          localized:
          - en:
              name: Animal, guard
              description: |-
                Trained attack dogs or similar. Requires Animal Handling skill to control effectively.
          - es:
              name: tapones para los oidos
              description: ''
        biolock:
          pl: '6'
          mass: '-'
          cost: '100'
          localized:
          - en:
              name: Biolock
              description: |-
                Keyless padlock recognizing bioelectric signatures. Extremely difficult to pick. Has armor rating and durability.
          - es:
              name: Traje electrónico, suave
              description: |-
                Un traje ambiental flexible para protección contra atmósferas peligrosas o vacío.
        handcuffs:
          pl: '4'
          mass: '1'
          cost: '50'
          localized:
          - en:
              name: Handcuffs
              description: |-
                Restraints that impose a +3 penalty to actions. PL 6 binders impose a +3 to +5 penalty and cost significantly more.
          - es:
              name: E-traje, duro
              description: |-
                Un traje ambiental rígido y blindado para condiciones extremas, que ofrece protección mejorada y soporte vital.
        holoviewer:
          pl: '7'
          mass: '3'
          cost: '500'
          localized:
          - en:
              name: Holoviewer
              description: |-
                Projector for high-quality 3D holographic images using force field technology. Includes audio and odor emitters.
          - es:
              name: baliza de emergencia
              description: ''
        psi-restraint-helmet:
          pl: '6'
          mass: '2'
          cost: '1200'
          localized:
          - en:
              name: Psi-restraint (Helmet)
              description: |-
                fitted with neural interference circuits that add a +4 penalty to psionic powers and a +1 penalty to Intelligence checks.
          - es:
              name: Extintor de incendios
              description: ''
        psi-restraint-collar:
          pl: '6'
          mass: '1'
          cost: '1700'
          localized:
          - en:
              name: Psi-restraint (Collar)
              description: |-
                Necklace restraint with same penalties as helmet; explodes or signals if tampered with.
          - es:
              name: Llamarada
              description: ''
        psi-restraint-implant:
          pl: '6'
          mass: '-'
          cost: '3500'
          localized:
          - en:
              name: Psi-restraint (Implant)
              description: |-
                Base-of-skull implant regulating psionic power with settings up to a +5 penalty.
          - es:
              name: Flash
              description: ''
services:
