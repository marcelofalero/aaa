[{{ $first := true }}
{{ range $page := .Site.RegularPages }}
  {{ $section := index (split $page.File.Dir "/") 0 }}
  {{ if not (in (slice "backgrounds" "equipment" "skills" "perks_and_flaws" "species" "professions") $section) }}
    {{ if not $first }}, {{ end }}
    {
      "title": {{ $page.Title | plainify | jsonify }},
      "url": {{ $page.RelPermalink | jsonify }},
      "description": {{ $page.Params.description | default $page.Summary | plainify | truncate 120 | jsonify }},
      "section": {{ $section | jsonify }}
    }
    {{ $first = false }}
  {{ end }}
{{ end }}

{{/* Add Equipment and other discovered Data */}}
{{ range $file_key, $data := hugo.Data }}
  {{ if and (reflect.IsMap $data) $data.search_config }}
    {{/* Language matching logic: 
         - In EN build: skip ES files
         - In ES build: prioritize ES files, fallback to EN if no ES version exists 
    */}}
    {{ $is_es := or (in $file_key ".es") (in $file_key "_es") }}
    {{ $base_key := strings.TrimSuffix ".es" (strings.TrimSuffix "_es" $file_key) }}
    {{ $has_es := index hugo.Data (printf "%s.es" $base_key) | default (index hugo.Data (printf "%s_es" $base_key)) }}
    
    {{ $should_index := false }}
    {{ if eq $.Lang "es" }}
      {{ if or $is_es (not $has_es) }}{{ $should_index = true }}{{ end }}
    {{ else }}
      {{ if not $is_es }}{{ $should_index = true }}{{ end }}
    {{ end }}

    {{ if $should_index }}
      {{ $conf := $data.search_config }}
      {{/* Discovery: Look for 'groups' at top level or within categories */}}
      {{ $targets := slice }}
      {{ if $data.groups }}
        {{ $targets = $targets | append (dict "name" "" "groups" $data.groups) }}
      {{ end }}
      {{ $cats := $data.categories | default $data }}
      {{ range $k, $v := $cats }}
        {{ if and (reflect.IsMap $v) (ne $k "search_config") (ne $k "config") (ne $k "groups") }}
          {{ if $v.groups }}
            {{ $targets = $targets | append (dict "name" $k "groups" $v.groups) }}
          {{ end }}
        {{ end }}
      {{ end }}

      {{ range $target := $targets }}
        {{ $cat_name := $target.name }}
        {{ range $g_key, $g_val := $target.groups }}
          {{ $items := slice }}
          {{ if reflect.IsMap $g_val }}
            {{ $items = $g_val.items }}
          {{ else if reflect.IsSlice $g_val }}
            {{ $items = $g_val }}
          {{ end }}
          
          {{ range $item := $items }}
            {{ $item_title := $item.name | default $item.skill }}
            {{ if $item_title }}
              {{ if not $first }}, {{ end }}
              {
                "title": {{ $item_title | jsonify }},
                "url": {{ $item.skill_url | default (printf "%s#%s" ($conf.base_url | default "/") ($item_title | urlize)) | relLangURL | jsonify }},
                "description": {{ printf "%s%s" ($conf.display_name | default "EQUIPMENT") (cond (ne $cat_name "") (printf " (%s)" (upper $cat_name)) "") | jsonify }},
                "section": {{ $conf.section | default "equipment" | jsonify }}
              }
              {{ $first = false }}
            {{ end }}
          {{ end }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}]
